<Window x:Class="AplicativoDeAlmacen.Views.PermisosRolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matriz de Seguridad y Accesos por Rol" Height="720" Width="1080"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER PROFESIONAL -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="20,15" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="POLÍTICAS Y ACCESOS DEL SISTEMA" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Rol en configuración: " Foreground="#E2E8F0" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNombreRol" Text="ADMINISTRADOR" Foreground="#38BDF8" FontSize="18" FontWeight="Black"/>
                    </StackPanel>
                </StackPanel>

                <!-- BUSCADOR RÁPIDO DE MÓDULOS -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="260">
                    <TextBlock Text="Filtrar módulo:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtFiltroModulo" Height="30" VerticalContentAlignment="Center" Padding="8,2"
                             Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="TxtFiltroModulo_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL: PANEL LATERAL DE CATEGORÍAS + TABLA ALINEADA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: CATEGORÍAS -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATEGORÍAS" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,4,6,10"/>

                    <ListBox x:Name="LstCategorias" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             SelectionChanged="LstCategorias_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="BrdItem" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BrdItem" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="BrdItem" Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- ACCIONES DE GRUPO -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Acciones de la sección:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Button Content="✓ Activar todo el bloque" Height="26" FontSize="11" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" Click="BtnActivarCategoria_Click" Margin="0,0,0,4"/>
                            <Button Content="✕ Desactivar este bloque" Height="26" FontSize="11" Background="#F1F5F9" Foreground="#EF4444" BorderBrush="#CBD5E1" Click="BtnDesactivarCategoria_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: MATRIZ DE MÓDULOS -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock x:Name="TxtTituloSeccion" Text="Todos los módulos" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Solo Lectura (Ver)" Padding="8,4" FontSize="11" Background="#F8FAFC" BorderBrush="#CBD5E1" Margin="0,0,6,0" Click="BtnSoloLecturaGlobal_Click"/>
                            <Button Content="Conceder Todo" Padding="8,4" FontSize="11" Background="#ECFDF5" Foreground="#047857" BorderBrush="#A7F3D0" Margin="0,0,6,0" Click="BtnTodoGlobal_Click"/>
                            <Button Content="Quitar Todo" Padding="8,4" FontSize="11" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" Click="BtnLimpiarTodoGlobal_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- TABLA SIN GROUPSTYLE QUE NO DESALINEA -->
                    <DataGrid x:Name="PermisosDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="False" BorderThickness="0" RowHeight="42" Background="Transparent"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              RowBackground="White" AlternatingRowBackground="#FAFAFA">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- CATEGORÍA / GRUPO -->
                            <DataGridTextColumn Header="GRUPO" Binding="{Binding CategoriaNombre}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- MÓDULO -->
                            <DataGridTextColumn Header="MÓDULO DEL SISTEMA" Binding="{Binding NombreModulo}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- VER -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="VER" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <CheckBox Click="ChkAllVer_Click" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PuedeVer, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CREAR -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="CREAR" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <CheckBox Click="ChkAllCrear_Click" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PuedeCrear, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- EDITAR -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="EDITAR" Foreground="#D97706" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <CheckBox Click="ChkAllEditar_Click" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PuedeEditar, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ELIMINAR -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="BORRAR" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <CheckBox Click="ChkAllEliminar_Click" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PuedeEliminar, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- IMPRIMIR -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="IMPRIMIR" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <CheckBox Click="ChkAllImprimir_Click" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PuedeImprimir, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock Text="💡 Los cambios aplicados tendrán efecto inmediato en el siguiente inicio de sesión." 
                           Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="110" Height="36" Background="White" Foreground="#475569" 
                            BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                    <Button Content="💾 Guardar Políticas" Width="170" Height="36" Background="#059669" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGuardar_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>