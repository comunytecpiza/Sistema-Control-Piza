<Application x:Class="AplicativoDeAlmacen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AplicativoDeAlmacen"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Estos dos diccionarios le dan a HandyControl sus
                    estilos, plantillas, colores y animaciones.
                    Sin esto, Growl (y cualquier otro control de
                    HandyControl) se ejecuta sin error pero no tiene
                    apariencia visual.
                -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tu estilo original, intacto -->
            <Style x:Key="HoverButton" TargetType="Button">
                <Setter Property="Background" Value="#DDDDDD"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#BBBBBB"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#999999"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Estilo global para TODOS los DataGrid de la aplicación.
                Como no tiene x:Key, se aplica automáticamente a cualquier
                DataGrid sin que tengas que escribir nada extra en cada
                pantalla (DgCategorias, DgModulos, DgVistasDetectadas, etc).

                Objetivo: que las filas y columnas se distingan claramente
                a simple vista (pensado para usuarios mayores o con
                dificultad para leer tablas "planas" sin separación).
            -->
            <Style TargetType="DataGrid">
                <!-- Líneas verticales (entre columnas) y horizontales (entre filas) -->
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E1"/>
                <Setter Property="VerticalGridLinesBrush" Value="#CBD5E1"/>

                <!-- Bordes generales de la tabla, más marcados -->
                <Setter Property="BorderBrush" Value="#94A3B8"/>
                <Setter Property="BorderThickness" Value="1"/>

                <!-- Filas alternadas (cebra) para que sea fácil seguir una fila
                     de izquierda a derecha sin perderse en la siguiente -->
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="RowBackground" Value="White"/>

                <!-- Resaltado claro al seleccionar una fila -->
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="HeadersVisibility" Value="Column"/>

                <!-- Texto un poco más grande y con más espacio,
                     más fácil de leer para todas las edades -->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="RowHeight" Value="42"/>
            </Style>

            <!-- Encabezados de columna: fondo sólido y separación clara
                 respecto a las filas de datos -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#1E293B"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="#475569"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Celdas: separación visual clara y buen contraste al
                 seleccionar -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>