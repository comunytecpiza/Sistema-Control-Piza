<UserControl x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Kardex.KardexUbicacionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#81C784" BorderThickness="2" CornerRadius="10" Padding="20" Margin="0,0,0,20" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Direction="270"/>
            </Border.Effect>

            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Producto:" FontWeight="Bold" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <TextBox x:Name="TxtProducto" Width="250" Height="30" VerticalContentAlignment="Center" TextChanged="TxtProducto_TextChanged"/>
                            <Popup x:Name="PopupProducto" PlacementTarget="{Binding ElementName=TxtProducto}" StaysOpen="False" AllowsTransparency="True">
                                <ListBox x:Name="LstProducto" Width="250" MaxHeight="150" SelectionChanged="LstProducto_SelectionChanged" DisplayMemberPath="Descripcion"/>
                            </Popup>
                        </Grid>
                        <TextBox x:Name="TxtCodProducto" Width="70" Height="30" IsReadOnly="True" Background="#F9FAFB" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Ubicación:" FontWeight="Bold" Foreground="#4B5563"/>
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <TextBox x:Name="TxtUbicacion" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="TxtUbicacion_TextChanged"/>
                            <Popup x:Name="PopupUbicacion" PlacementTarget="{Binding ElementName=TxtUbicacion}" StaysOpen="False" AllowsTransparency="True">
                                <ListBox x:Name="LstUbicacion" Width="200" MaxHeight="150" SelectionChanged="LstUbicacion_SelectionChanged" DisplayMemberPath="Descripcion"/>
                            </Popup>
                        </Grid>
                        <TextBox x:Name="TxtCodUbicacion" Width="70" Height="30" IsReadOnly="True" Background="#F9FAFB" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Desde:" FontWeight="Bold" Foreground="#4B5563"/>
                    <DatePicker x:Name="DpDesde" Width="120" Height="30"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Hasta:" FontWeight="Bold" Foreground="#4B5563"/>
                    <DatePicker x:Name="DpHasta" Width="120" Height="30"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Ejecutar" Click="BtnEjecutar_Click" Background="#4CAF50" Foreground="White" Width="90" Height="30" Margin="0,0,5,0"/>
                    <Button Content="Imprimir" Click="BtnImprimir_Click" Background="#2196F3" Foreground="White" Width="90" Height="30" Margin="5,0"/>
                    <Button Content="Salir" Click="BtnSalir_Click" Background="#F44336" Foreground="White" Width="90" Height="30" Margin="5,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" Background="White" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#B71C1C" Padding="10">
                        <TextBlock Text="Resumen de Movimientos" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <DataGrid x:Name="DgResumen" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="DgResumen_SelectionChanged" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFE699"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Documento" Binding="{Binding NumeroRegistro}" Width="*"/>
                            <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocialUbicacion}" Width="2*"/>
                            <DataGridTextColumn Header="Ingreso" Binding="{Binding Ingreso}" Width="*"/>
                            <DataGridTextColumn Header="Salida" Binding="{Binding Salida}" Width="*"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="White" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#B71C1C" Padding="10">
                        <TextBlock Text="Detalle de Códigos" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <DataGrid x:Name="DgDetalles" AutoGenerateColumns="False" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFE699"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="*"/>
                            <DataGridTextColumn Header="Colección / Tipo" Binding="{Binding ColeccionTipo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>