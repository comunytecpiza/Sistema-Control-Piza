<Window x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Consulta.ExportarStockModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opciones de Exportación Excel" Height="280" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F4F6" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📤 Configurar Exportación de Códigos" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Seleccione los tipos de códigos a incluir en el Excel:" FontSize="13" Foreground="#4B5563" Margin="0,0,0,15"/>

                <CheckBox x:Name="ChkOperativos" Content="✅ Incluir Códigos Operativos (Guía y Venta)" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#047857" Margin="0,0,0,12"/>
                <CheckBox x:Name="ChkRestringidos" Content="⚠️ Incluir Códigos con Merma / Restricción" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="❌ Cancelar" Width="100" Height="38" Background="#9CA3AF" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click" Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="💾 Exportar" Width="110" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnExportar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>