<UserControl x:Class="AplicativoDeAlmacen.Views.Catalogo_y_tablas.AlmacenesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9" FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🌟 TÍTULO PRINCIPAL -->
        <TextBlock Grid.Row="0" Text="🏢 Gestión de Almacenes y Sedes" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

        <!-- 🌟 BARRA SUPERIOR DE HERRAMIENTAS Y BÚSQUEDA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0" FontSize="13"/>
                    <TextBox x:Name="TxtBuscar" Width="240" Margin="0,0,15,0" TextChanged="TxtBuscar_TextChanged" ToolTip="Buscar por código, nombre o dirección..."/>

                    <TextBlock Text="Estado:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0" FontSize="13"/>
                    <ComboBox x:Name="CmbFiltroEstado" Width="140" SelectionChanged="CmbFiltroEstado_SelectionChanged">
                        <ComboBoxItem Content="-- TODOS --" Tag="-1" IsSelected="True"/>
                        <ComboBoxItem Content="🟢 Activos" Tag="1"/>
                        <ComboBoxItem Content="🔴 Inactivos" Tag="0"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="➕ Nuevo Almacén" Click="BtnNuevoAlmacen_Click" Width="145" Height="34" Margin="0,0,8,0" Background="#10B981" Style="{StaticResource ModernButton}"/>
                    <Button Content="✏️ Editar" Click="BtnEditarAlmacen_Click" Width="100" Height="34" Margin="0,0,8,0" Background="#F59E0B" Style="{StaticResource ModernButton}"/>
                    <Button Content="🔄 Cambiar Estado" Click="BtnToggleEstado_Click" Width="135" Height="34" Background="#64748B" Style="{StaticResource ModernButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🌟 TABLA PRINCIPAL DE ALMACENES -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="DgAlmacenes" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent"
                      RowHeight="36" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" 
                      BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0369A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                    <DataGridTextColumn Header="Nombre del Almacén" Binding="{Binding Nombre}" Width="2*"/>
                    <DataGridTextColumn Header="Dirección Física" Binding="{Binding Direccion}" Width="3*"/>

                    <DataGridTemplateColumn Header="Estado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstadoId}" Value="0">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="ACTIVO"/>
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoId}" Value="0">
                                                        <Setter Property="Text" Value="INACTIVO"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 🌟 MODAL FLOTANTE DE REGISTRO / EDICIÓN -->
        <Grid x:Name="ModalAlmacen" Visibility="Collapsed" Background="#750F172A" Grid.RowSpan="3" Margin="-20">
            <Border Background="White" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="10" Padding="24" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitulo" Text="Registrar Almacén" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="Complete los datos para la sede física de control." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre del Almacén (*):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtNombreModal" Margin="0,0,0,12"/>

                    <TextBlock Text="Código / Sigla Identificadora:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtCodigoModal" Margin="0,0,0,12" CharacterCasing="Upper"/>

                    <TextBlock Text="Dirección Física:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtDireccionModal" Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkActivoModal" Content="Almacén Operativo / Activo" IsChecked="True" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,24"/>

                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Click="BtnCancelarModal_Click" Width="100" Height="36" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#475569" Style="{StaticResource ModernButton}"/>
                            <Button Content="💾 Guardar" Click="BtnGuardarModal_Click" Width="120" Height="36" Background="#2563EB" Style="{StaticResource ModernButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>