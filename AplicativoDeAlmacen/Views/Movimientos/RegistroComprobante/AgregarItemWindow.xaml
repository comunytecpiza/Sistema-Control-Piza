<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.AgregarItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Item" Height="550" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F9" FontFamily="Segoe UI">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#10B981" BorderThickness="1" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                <TextBox x:Name="TxtProductoBuscador" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,10,10" TextChanged="TxtProductoBuscador_TextChanged"/>
                <TextBox x:Name="TxtProductoId" Grid.Row="0" Grid.Column="2" Height="26" Margin="0,0,0,10" IsReadOnly="True" Background="#F1F5F9" TextAlignment="Center"/>

                <Popup x:Name="PopProducto" PlacementTarget="{Binding ElementName=TxtProductoBuscador}" StaysOpen="False" IsOpen="False">
                    <ListBox x:Name="LstProductos" MaxHeight="150" Width="{Binding ActualWidth, ElementName=TxtProductoBuscador}" SelectionChanged="LstProductos_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Descripcion}" Padding="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Popup>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="U. Medida :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                <TextBox x:Name="TxtUMedida" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="26" HorizontalAlignment="Left" Width="150" Margin="0,0,0,10" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Afectación IGV :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                <TextBox x:Name="TxtAfectacion" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="26" HorizontalAlignment="Left" Width="350" Margin="0,0,0,10" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cantidad :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                <TextBox x:Name="TxtCantidad"  Grid.Row="3" Grid.Column="1" Height="26" HorizontalAlignment="Left" Width="100" Margin="0,0,0,10" Text="0.00" TextAlignment="Right" TextChanged="Calculo_TextChanged"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="P. Unitario :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                <TextBox x:Name="TxtPreUnitario" Grid.Row="4" Grid.Column="1" Height="26" HorizontalAlignment="Left" Width="100" Margin="0,0,0,10" Text="0.00" TextAlignment="Right" TextChanged="Calculo_TextChanged"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Total :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtTotal" Grid.Row="5" Grid.Column="1" Height="26" HorizontalAlignment="Left" Width="100" Margin="0,0,0,0" Text="0.00" TextAlignment="Right" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#C53030" BorderThickness="1" Margin="0,0,10,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#C53030" Padding="5">
                        <TextBlock Text="Detalle de Códigos" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <DataGrid x:Name="DgCodigos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowHeight="26">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FDE047"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="BorderBrush" Value="#CBD5E0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoString}" Width="2*"/>
                            <DataGridTextColumn Header="Colección / Tipo" Binding="{Binding Coleccion}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="PanelCapturaCodigo" Grid.Row="2" Background="#EBF8FF" BorderBrush="#3182CE" BorderThickness="0,1,0,0" Padding="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Código :" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtCapturaCodigo" Width="200" Height="26" KeyDown="TxtCapturaCodigo_KeyDown"/>
                            <Button Content="Aceptar" Click="BtnConfirmarCodigo_Click" Width="70" Height="26" Margin="10,0,0,0" Background="#3182CE" Foreground="White"/>
                            <Button Content="Cancelar" Click="BtnCancelarCodigo_Click" Width="70" Height="26" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Button x:Name="BtnAgregarCod" Content="📄 Agregar" Click="BtnAgregarCod_Click" Height="40" Margin="0,0,0,10" Background="White" BorderBrush="Black" BorderThickness="1" IsEnabled="False"/>
                <Button x:Name="BtnModificarCod" Content="✏️ Modificar" Height="40" Margin="0,0,0,10" Background="White" BorderBrush="Black" BorderThickness="1" IsEnabled="False"/>
                <Button x:Name="BtnEliminarCod" Content="❌ Elminar" Click="BtnEliminarCod_Click" Height="40" Margin="0,0,0,30" Background="White" BorderBrush="Black" BorderThickness="1" IsEnabled="False"/>

                <Button x:Name="BtnGrabarItem" Content="💾 Grabar" Click="BtnGrabarItem_Click" Height="40" Margin="0,0,0,10" Background="White" BorderBrush="Black" BorderThickness="1"/>
                <Button Content="🚪 Salir" Click="BtnCerrar_Click" Height="40" Background="White" BorderBrush="Black" BorderThickness="1"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>