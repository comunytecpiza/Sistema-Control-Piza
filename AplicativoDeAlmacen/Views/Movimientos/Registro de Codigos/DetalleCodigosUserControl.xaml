<UserControl x:Class="AplicativoDeAlmacen.Views.DetalleCodigosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CARDS DE RESUMEN -->
        <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="PRODUCTO" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtProducto" FontSize="16" Foreground="#111827" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="CATEGORÍA" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCategoria" FontSize="16" Foreground="#111827" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="RANGO PRINCIPAL" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtRango" FontSize="15" Foreground="#111827" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtTotal" FontSize="14" Foreground="#2563EB" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="EXCEPCIONES / BAJAS" FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtExcepciones" FontSize="15" Foreground="#DC2626" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE ACCIONES Y CAMBIO DE CONDICIÓN POR RANGO -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. REGISTRO MANUAL (Solo Administrador) -->
                <StackPanel x:Name="PanelRegistroManual" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Excepción Manual N°:" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtNuevoCodigo" Width="80" FontSize="14" FontWeight="Bold" Padding="6" Background="#F9FAFB"/>
                    <Button Content="+ Registrar" Click="BtnRegistrarManual_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="8,0,20,0"/>
                </StackPanel>

                <!-- 2. CAMBIO DE CONDICIÓN POR RANGO (3 TIPOS) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ Cambiar Condición por Rango:" VerticalAlignment="Center" Foreground="#4B5563" FontWeight="Bold" Margin="0,0,10,0"/>

                    <ComboBox x:Name="CboNuevaCondicion" Width="160" Height="32" Margin="0,0,10,0" SelectedIndex="1">
                        <ComboBoxItem Content="OK / Operativo" Tag="1"/>
                        <ComboBoxItem Content="Dañado / Defectuoso" Tag="2"/>
                        <ComboBoxItem Content="Perdido / Extraviado" Tag="3"/>
                    </ComboBox>

                    <TextBlock Text="Desde:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtRangoDesde" Width="60" TextAlignment="Center" Padding="4"/>
                    <TextBlock Text="Hasta:" VerticalAlignment="Center" Foreground="#6B7280" Margin="8,0,4,0"/>
                    <TextBox x:Name="TxtRangoHasta" Width="60" TextAlignment="Center" Padding="4"/>

                    <Button Content="Aplicar Condición" Click="BtnConvertirMermaRango_Click" Background="#4F46E5" Foreground="White" FontWeight="Bold" Padding="10,6" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA PRINCIPAL DE CÓDIGOS -->
        <Border Grid.Row="2" CornerRadius="10" Background="White" Padding="5">
            <DataGrid x:Name="CodigosDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="Transparent" BorderThickness="0" RowHeight="40" HeadersVisibility="Column"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="CodigosDataGrid_SelectionChanged">

                <!-- 🌟 MENÚ CONTEXTUAL AL HACER CLIC DERECHO SOBRE LAS FILAS SELECCIONADAS -->
                <DataGrid.ContextMenu>
                    <ContextMenu FontSize="13" FontWeight="SemiBold">
                        <MenuItem Header="🟢 Cambiar a: OK / Operativo" Click="MenuItemCondicion_Click" Tag="1"/>
                        <MenuItem Header="🔴 Cambiar a: Dañado / Defectuoso" Click="MenuItemCondicion_Click" Tag="2"/>
                        <MenuItem Header="🟡 Cambiar a: Perdido / Extraviado" Click="MenuItemCondicion_Click" Tag="3"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>

                    <DataGridTextColumn Header="CÓDIGO GENERADO" Binding="{Binding Codigo}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="columnaAlmacen" 
                            Header="ALMACÉN RESIDENTE" 
                            Binding="{Binding AlmacenNombre}" 
                            Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CONDICIÓN CON FORMATO DINÁMICO SEGÚN CONDICION_ID -->
                    <DataGridTemplateColumn Header="CONDICIÓN / CALIDAD" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DEF7EC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CondicionId}" Value="2">
                                                    <Setter Property="Background" Value="#FDE8E8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CondicionId}" Value="3">
                                                    <Setter Property="Background" Value="#FEF08A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK / OPERATIVO"/>
                                                <Setter Property="Foreground" Value="#03543F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CondicionId}" Value="2">
                                                        <Setter Property="Text" Value="DAÑADO / DEFECTUOSO"/>
                                                        <Setter Property="Foreground" Value="#9B1C1C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CondicionId}" Value="3">
                                                        <Setter Property="Text" Value="PERDIDO / EXTRAVIADO"/>
                                                        <Setter Property="Foreground" Value="#854D0E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ORIGEN" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrigenCreacion}" VerticalAlignment="Center" Foreground="#6B7280" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="FECHA CREACIÓN" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- MODAL FLOTANTE DE AUDITORÍA (SOLO ADMINISTRADOR AL HACER DOBLE CLICK) -->
        <Grid x:Name="ModalAuditoria" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="3" Margin="-30">
            <Border Background="White" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12" Padding="25">
                <StackPanel>
                    <TextBlock Text="🔍 Auditoría Técnica de Código" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>
                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Código Físico:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudCodigo" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#2563EB"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Estado Calidad:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudCondicion" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Almacén Actual:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudAlmacen" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Usuario Creador / Modificador:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudUsuario" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#047857"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Origen de Creación:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudOrigen" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Fecha y Hora:" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock x:Name="AudFecha" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <Button Content="Cerrar Auditoría" Click="BtnCerrarAuditoria_Click" Background="#374151" Foreground="White" FontWeight="Bold" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>