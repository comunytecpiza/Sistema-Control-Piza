<UserControl x:Class="AplicativoDeAlmacen.Views.RegistroCodigosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📝 Maestro de Códigos de Barras" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,25"/>
        <ProgressBar x:Name="PbProgreso" Grid.Row="1" Height="4" Margin="0,0,0,10" Visibility="Collapsed" IsIndeterminate="True" Foreground="#3B82F6"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Colección:" VerticalAlignment="Center" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbFiltroColeccion" Width="120" SelectionChanged="Filtros_Changed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbLibroGuia" Content="Libros Guía" IsChecked="True" Checked="Filtros_Changed" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbLibroVenta" Content="Libros Venta" Checked="Filtros_Changed" Foreground="#374151" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Generar Nuevo Lote" Click="BtnNuevo_Click" Background="#10B981" Margin="0,0,15,0" MinWidth="170"/>
                <Button Content="🗑️ Eliminar Lote" Click="BtnEliminar_Click" Background="#EF4444" MinWidth="130"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" CornerRadius="10" Background="White" Padding="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.08" Direction="270"/>
            </Border.Effect>

            <DataGrid x:Name="CodigosDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" 
                      RowHeight="45" HeadersVisibility="Column" GridLinesVisibility="None">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="BorderBrush" Value="#F3F4F6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Producto.Descripcion}" Width="2.5*"/>
                    <DataGridTextColumn Header="U. MEDIDA" Binding="{Binding Producto.UnidadMedida.Descripcion}" Width="1.5*"/>

                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="DESDE" Binding="{Binding Desde}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="HASTA" Binding="{Binding Hasta}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ACCIONES" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="👁️ Detalles" Click="BtnVerDetalle_Click" Background="#EFF6FF" 
                                        Foreground="#2563EB" FontWeight="Bold" Padding="10,6" Margin="2,0" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid x:Name="ModalAgregar" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="3" Margin="-30">
            <Border Background="White" Width="800" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16" Padding="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Generar Nuevos Códigos" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>
                    <TextBlock Text="Configure los detalles para la generación del nuevo bloque de códigos." Foreground="#6B7280" FontSize="14" Margin="0,0,0,25"/>
                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,30"/>

                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Datos Base" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15" FontSize="16"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Colección:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbModalColeccion"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Categoría:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbModalCategoria"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Producto:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbProducto" IsEditable="True" StaysOpenOnEdit="True"
                                      DisplayMemberPath="Descripcion" TextSearch.TextPath="Descripcion"
                                      TextBoxBase.TextChanged="CmbProducto_TextChanged" SelectionChanged="CmbProducto_SelectionChanged"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#E5E7EB" Margin="19,0"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rango de Generación" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15" FontSize="16"/>

                            <TextBlock Text="Cantidad a generar:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtCantidad" TextChanged="TxtCantidad_TextChanged" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Código Inicial:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtDesde" IsReadOnly="True" Foreground="#111827" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Código Final:" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtHasta" IsReadOnly="True" Foreground="#111827" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#E5E7EB" Margin="0,0,0,25"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnCancelar_Click" Background="Transparent" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,15,0" Width="100"/>
                        <Button x:Name="btnGuardar" Content="💾 Subir y Generar Lote" Click="BtnGuardar_Click" Background="#3B82F6" Width="220" FontSize="15"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>