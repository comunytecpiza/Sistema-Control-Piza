<Window x:Class="AplicativoDeAlmacen.Views.PermisosRolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matriz de Seguridad y Accesos" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI" Background="#F1F5F9">

    <Window.Resources>
        <CollectionViewSource x:Key="PermisosAgrupados">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CategoriaNombre"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" CornerRadius="12" Padding="25" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="MATRIZ DE PRIVILEGIOS DEL SISTEMA" Foreground="#94A3B8" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Configurando accesos para el rol: " Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtNombreRol" Text="ROL" Foreground="#38BDF8" FontSize="22" FontWeight="Black"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="PermisosDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" 
                  BorderThickness="0" RowHeight="50" Background="Transparent" HeadersVisibility="Column" 
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  RowBackground="White" AlternatingRowBackground="#F8FAFC"
                  ItemsSource="{Binding Source={StaticResource PermisosAgrupados}}">

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,20"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Border Background="#334155" Padding="20,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📁 " FontSize="16" Foreground="White" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                                    </StackPanel>
                                                </Border>
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="FontWeight" Value="Black"/>
                    <Setter Property="Padding" Value="10,0,10,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="MÓDULO DEL SISTEMA" Binding="{Binding NombreModulo}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="25,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="VER" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#3B82F6"/>
                            <CheckBox Click="ChkAllVer_Click" HorizontalAlignment="Center" ToolTip="Marcar/Desmarcar Todo"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding PuedeVer, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="CREAR" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#10B981"/>
                            <CheckBox Click="ChkAllCrear_Click" HorizontalAlignment="Center" ToolTip="Marcar/Desmarcar Todo"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding PuedeCrear, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="EDITAR" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#F59E0B"/>
                            <CheckBox Click="ChkAllEditar_Click" HorizontalAlignment="Center" ToolTip="Marcar/Desmarcar Todo"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding PuedeEditar, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="ELIMINAR" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#EF4444"/>
                            <CheckBox Click="ChkAllEliminar_Click" HorizontalAlignment="Center" ToolTip="Marcar/Desmarcar Todo"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding PuedeEliminar, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.Header>
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock Text="IMPRIMIR" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#8B5CF6"/>
                            <CheckBox Click="ChkAllImprimir_Click" HorizontalAlignment="Center" ToolTip="Marcar/Desmarcar Todo"/>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding PuedeImprimir, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="❌ Cancelar" Width="130" Height="45" Background="White" Foreground="#64748B" FontWeight="Bold" FontSize="14" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Margin="0,0,12,0" Click="BtnCancelar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="💾 Guardar Políticas" Width="200" Height="45" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnGuardar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>