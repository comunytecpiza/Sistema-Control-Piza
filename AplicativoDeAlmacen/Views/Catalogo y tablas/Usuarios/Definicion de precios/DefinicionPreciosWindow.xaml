<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.DefinicionPreciosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definición de Precios" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA: Buscador y Botones -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Buscar Producto:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtBuscarProducto" Width="250" Height="32" Padding="5" VerticalContentAlignment="Center" TextChanged="TxtBuscarProducto_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✏️ Modificar Precio" Click="BtnModificar_Click" Width="130" Height="35" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🚪 Salir" Click="BtnSalir_Click" Width="80" Height="35" Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- GRILLA DE PRODUCTOS -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid x:Name="DgProductos" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" RowHeight="32" HeadersVisibility="Column" SelectionChanged="DgProductos_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FDE047"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding ProductoId}" Width="70"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="3*"/>
                        <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="100"/>
                        <DataGridTextColumn Header="Precio Base" Binding="{Binding PrecioBase, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="P. Especial" Binding="{Binding PrecioEspecial, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="%" Binding="{Binding PorcentajeMostrar, StringFormat=N2}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- MODAL DE EDICIÓN DE PRECIO (Se sobrepone) -->
        <Grid x:Name="ModalEdicion" Background="#A0000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Width="450" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#10B981" BorderThickness="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Código :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                    <TextBox x:Name="TxtModCodigo" Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Descripción :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                    <TextBox x:Name="TxtModDesc" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="U. Medida :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                    <TextBox x:Name="TxtModUMedida" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tipo Precio :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbPrecioNormal" Content="Precio Normal" Margin="0,0,15,0" Checked="RbTipoPrecio_Checked" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbPrecioEspecial" Content="Precio Especial" Checked="RbTipoPrecio_Checked" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Precio Unitario:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>
                    <TextBox x:Name="TxtModPrecio" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="% Bonificación:" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,5,10,0"/>
                    <TextBox x:Name="TxtModPorcentaje" Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5"/>

                    <!-- Botones Modal -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="💾 Grabar" Click="BtnGrabarPrecio_Click" Width="90" Height="32" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Cancelar" Click="BtnCerrarModal_Click" Width="80" Height="32" Background="White" BorderBrush="#CBD5E0" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>