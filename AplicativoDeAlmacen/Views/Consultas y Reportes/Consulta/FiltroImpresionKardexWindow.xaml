<Window x:Class="AplicativoDeAlmacen.Views.FiltroImpresionKardexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opciones de Impresión" Height="314" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F4F6" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🖨️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Filtrar Contenido a Imprimir" FontSize="15" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Opciones de Checkboxes en un Border estilizado -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15">
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="ChkEnviados" Content="Detalle Enviados" IsChecked="True" Margin="0,0,0,12" FontSize="13" Foreground="#334155" FontWeight="SemiBold"/>
                <CheckBox x:Name="ChkDevueltos" Content="Detalle Devueltos" IsChecked="True" Margin="0,0,0,12" FontSize="13" Foreground="#334155" FontWeight="SemiBold"/>
                <CheckBox x:Name="ChkVendidos" Content="Detalle Vendidos" IsChecked="True" FontSize="13" Foreground="#334155" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnImprimir" Content="🖨️ Aceptar" Width="95" Height="35" Margin="0,0,8,0"
                    Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnImprimir_Click"/>
            <Button x:Name="BtnSalir" Content="Cancelar" Width="85" Height="35"
                    Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnSalir_Click"/>
        </StackPanel>
    </Grid>
</Window>