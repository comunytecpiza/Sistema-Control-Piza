<UserControl x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Kardex.KardexValorizado.KardexValorizadoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6" FontFamily="Segoe UI"
             xml:lang="es-PE">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#81C784" BorderThickness="2" CornerRadius="10" Padding="20" Margin="0,0,0,15" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Direction="270"/>
            </Border.Effect>

            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Producto:" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CboProducto"
      Width="380"
      Height="30"
      VerticalContentAlignment="Center"
      IsEditable="True"
      IsTextSearchEnabled="False"
      StaysOpenOnEdit="True"
      SelectedValuePath="Id"
      TextSearch.TextPath="Descripcion" 
      KeyUp="CboProducto_KeyUp"
      SelectionChanged="CboProducto_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="350" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Descripcion}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Abreviatura}" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <Border Grid.Column="2" Background="#EEE8AA" CornerRadius="2" Padding="5,0">
                                            <TextBlock Text="{Binding Cantidad, StringFormat=N2}" Foreground="#000000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="TxtCodProducto" Width="70" Height="30" IsReadOnly="True" Background="#F9FAFB" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Desde:" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpDesde" Width="120" Height="30"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,10">
                    <TextBlock Text="Hasta:" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpHasta" Width="120" Height="30"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="50,0,0,10" RenderTransformOrigin="0.506,0.546">
                    <Button Content="Ejecutar" Click="BtnEjecutar_Click" Background="#4CAF50" Foreground="White" Width="90" Height="30" Margin="0,0,5,0" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="Imprimir" Click="BtnImprimir_Click" Background="#2196F3" Foreground="White" Width="90" Height="30" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#BDBDBD" BorderThickness="1">
            <DataGrid x:Name="DgResumen" AutoGenerateColumns="False" SelectionMode="Single" 
                  BorderThickness="0" Background="White" RowHeight="28" 
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                  AlternatingRowBackground="#FAFAFA">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAnulado}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="ToolTip" Value="Este movimiento fue ANULADO y su saldo fue revertido." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="85"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="160"/>
                    <DataGridTextColumn Header="# Registro" Binding="{Binding Registro}" Width="120"/>
                    <DataGridTextColumn Header="Razón Social / Ubicación" Binding="{Binding RazonSocialUbicacion}" Width="250"/>
                    <DataGridTextColumn Header="# Guía" Binding="{Binding Guia}" Width="120"/>

                    <DataGridTextColumn Header="C. Unitario" Binding="{Binding CostoUnitario, StringFormat={}{0:N2}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="C. Promedio" Binding="{Binding CostoPromedio, StringFormat={}{0:N2}}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ingresos" Binding="{Binding IngresoFisico, StringFormat={}{0:N2}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Salidas" Binding="{Binding SalidaFisico, StringFormat={}{0:N2}}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="S. Final" Binding="{Binding SaldoFisico, StringFormat={}{0:N2}}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0" BorderBrush="#BDBDBD" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="#EEE8AA" BorderBrush="#BDBDBD" BorderThickness="0,0,1,1">
                    <TextBlock Text="S. Inicial" FontWeight="SemiBold" TextAlignment="Center" Padding="5"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#EEE8AA" BorderBrush="#BDBDBD" BorderThickness="0,0,1,1">
                    <TextBlock Text="C. Inicial" FontWeight="SemiBold" TextAlignment="Center" Padding="5"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#EEE8AA" BorderBrush="#BDBDBD" BorderThickness="0,0,1,1">
                    <TextBlock Text="T. Ingresos" FontWeight="SemiBold" TextAlignment="Center" Padding="5"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Background="#EEE8AA" BorderBrush="#BDBDBD" BorderThickness="0,0,1,1">
                    <TextBlock Text="T. Salidas" FontWeight="SemiBold" TextAlignment="Center" Padding="5"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Background="#EEE8AA" BorderBrush="#BDBDBD" BorderThickness="0,0,0,1">
                    <TextBlock Text="S. Final" FontWeight="SemiBold" TextAlignment="Center" Padding="5"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#BDBDBD" BorderThickness="0,0,1,0">
                    <TextBlock x:Name="TxtSaldoInicial" Text="0.00" FontWeight="Bold" TextAlignment="Right" Padding="5"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#BDBDBD" BorderThickness="0,0,1,0">
                    <TextBlock x:Name="TxtCostoInicial" Text="0.00" FontWeight="Bold" TextAlignment="Right" Padding="5"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#BDBDBD" BorderThickness="0,0,1,0">
                    <TextBlock x:Name="TxtTotalIngresos" Text="0.00" FontWeight="Bold" TextAlignment="Right" Padding="5"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" BorderBrush="#BDBDBD" BorderThickness="0,0,1,0">
                    <TextBlock x:Name="TxtTotalSalidas" Text="0.00" FontWeight="Bold" TextAlignment="Right" Padding="5"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="4">
                    <TextBlock x:Name="TxtSaldoFinal" Text="0.00" FontWeight="Bold" TextAlignment="Right" Padding="5"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>