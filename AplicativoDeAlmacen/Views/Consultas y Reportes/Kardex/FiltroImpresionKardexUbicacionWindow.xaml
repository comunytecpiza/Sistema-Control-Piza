<Window x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Kardex.FiltroImpresionKardexUbicacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportación de Kárdex y Liquidación" 
        Height="570" Width="560"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN DE EXPORTACIÓN EXCEL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                <TextBlock Text="Kárdex de Movimientos y Liquidación" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- CUERPO PRINCIPAL -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 1. SELECTOR MAESTRO: GUÍAS VS VENTAS -->
                    <TextBlock Text="1. TIPO DE REPORTE Y MATERIAL:" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TARJETA GUÍAS -->
                        <RadioButton x:Name="RbReporteGuias" Grid.Column="0" IsChecked="True" GroupName="TipoReporteGrupo"
                                     Checked="TipoReporte_SelectionChanged">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="BrdGuia" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="📘 LIBROS GUIA" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Libros Guía y Muestras de Promotoría" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="BrdGuia" Property="Background" Value="#EFF6FF"/>
                                            <Setter TargetName="BrdGuia" Property="BorderBrush" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- TARJETA VENTAS -->
                        <RadioButton x:Name="RbReporteVentas" Grid.Column="2" GroupName="TipoReporteGrupo"
                                     Checked="TipoReporte_SelectionChanged">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="BrdVenta" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="🛒 LIBROS VENTA" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Ventas netas, stands y puntos de venta" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="BrdVenta" Property="Background" Value="#ECFDF5"/>
                                            <Setter TargetName="BrdVenta" Property="BorderBrush" Value="#059669"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <!-- 2. ALCANCE DEL REPORTE -->
                    <TextBlock Text="2. ALCANCE DE LA EXPORTACIÓN:" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <RadioButton x:Name="RbAlcanceUbicacionActual" Content="1. Solo la Ubicación consultada (Hoja única)" IsChecked="True" 
                                         FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Checked="Alcance_SelectionChanged"/>

                            <RadioButton x:Name="RbAlcanceProductoActual" Content="2. Solo el Producto consultado (En todas las ubicaciones)" 
                                         FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Checked="Alcance_SelectionChanged"/>

                            <RadioButton x:Name="RbAlcanceProductoEnUbicacion" Content="3. Este Producto específico en esta Ubicación" 
                                         FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Checked="Alcance_SelectionChanged"/>

                            <RadioButton x:Name="RbAlcanceGeneralConsolidado" Content="4. Matriz General Consolidada (Todas las ubicaciones del sistema)" 
                                         FontWeight="SemiBold" Foreground="#1E293B" Checked="Alcance_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. DETALLES Y PARÁMETROS -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Campaña / Año:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtCampana" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="#F8FAFC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Estructura de salida:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CboEstructuraSalida" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="📊 Matriz Académica (Columnas de Grado)"/>
                                <ComboBoxItem Content="📄 Detalle Línea por Línea con Códigos"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- CUADRO INFORMATIVO EN TIEMPO REAL -->
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtResumenAccion" Text="Exportando: Libros Guía para la ubicación actual." 
                                       FontSize="11.5" Foreground="#166534" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- BOTONES INFERIORES -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Height="36" Background="White" Foreground="#475569" 
                    BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnExportar" Content="📊 Generar Excel" Width="150" Height="36" Background="#059669" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnExportar_Click"/>
        </StackPanel>
    </Grid>
</Window>