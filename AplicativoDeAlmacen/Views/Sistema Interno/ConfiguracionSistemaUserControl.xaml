<UserControl x:Class="AplicativoDeAlmacen.Views.ConfiguracionSistemaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             Loaded="UserControl_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA PRINCIPAL -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="⚙️ Motor de Configuración del Sistema" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Gestione categorías, registre nuevos módulos y sincronice las vistas XAML del proyecto." FontSize="13.5" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="PanelTab" Padding="20,11" Margin="0,0,6,0" Background="#E2E8F0" 
                                        BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="8,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="PanelTab" Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: CATEGORÍAS -->
            <TabItem Header="📁 Categorías">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
                            <Button Content="✨ Nueva Categoría" Width="160" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="BtnNuevaCategoria_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="✏️ Editar" Width="110" Height="38" Background="#F59E0B" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="10,0,0,0" Click="BtnEditarCategoria_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="🔄 Cambiar Estado" Width="150" Height="38" Background="#64748B" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="10,0,0,0" Click="BtnEstadoCategoria_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="DgCategorias" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                  Background="White" BorderBrush="#E2E8F0" HeadersVisibility="Column" RowHeight="40" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ORDEN" Binding="{Binding Orden}" Width="80"/>
                                <DataGridTextColumn Header="ICONO" Binding="{Binding Icono}" Width="80"/>
                                <DataGridTextColumn Header="NOMBRE DE CATEGORÍA" Binding="{Binding Nombre}" Width="*" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="COLOR" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Color}" Width="60" Height="22" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ACTIVO" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Estado}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Checked="ChkCategoriaEstado_Changed" Unchecked="ChkCategoriaEstado_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: MÓDULOS ACTIVOS -->
            <TabItem Header="🧩 Módulos Activos">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
                            <Button Content="✨ Nuevo Módulo" Width="150" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="BtnNuevoModulo_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="✏️ Editar" Width="110" Height="38" Background="#F59E0B" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="10,0,0,0" Click="BtnEditarModulo_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="🔄 Cambiar Estado" Width="150" Height="38" Background="#64748B" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="10,0,0,0" Click="BtnEstadoModulo_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="DgModulos" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                  Background="White" BorderBrush="#E2E8F0" HeadersVisibility="Column" RowHeight="40" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ORDEN" Binding="{Binding Orden}" Width="80"/>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoModulo}" Width="190" FontWeight="Bold"/>
                                <DataGridTextColumn Header="NOMBRE DEL MÓDULO" Binding="{Binding NombreModulo}" Width="250"/>
                                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding NombreCategoria}" Width="200" Foreground="#64748B"/>
                                <DataGridTextColumn Header="VISTA (XAML)" Binding="{Binding ControlWpf}" Width="*"/>
                                <DataGridTemplateColumn Header="ACTIVO" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Estado}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Checked="ChkModuloEstado_Changed" Unchecked="ChkModuloEstado_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: ESCÁNER DE VISTAS NUEVAS -->
            <TabItem Header="📡 Escáner de Vistas Nuevas">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
                            <Button Content="🔄 Escanear Proyecto" Width="190" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="BtnEscanear_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="💾 Registrar Seleccionadas" Width="210" Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="12,0,0,0" Click="BtnRegistrar_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="DgVistasDetectadas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  Background="White" BorderBrush="#E2E8F0" HeadersVisibility="Column" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding Seleccionada, UpdateSourceTrigger=PropertyChanged}" Width="55">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="NOMBRE DEL COMPONENTE (XAML)" Binding="{Binding NombreVista}" Width="320" IsReadOnly="True" FontWeight="Bold"/>
                                <DataGridTextColumn Header="RUTA INTERNA (NAMESPACE)" Binding="{Binding RutaCompleta}" Width="*" IsReadOnly="True" Foreground="#64748B"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>