<UserControl x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Graficos.ReporteStockCriticoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🚨 Reporte de Stock Crítico" FontSize="26" FontWeight="Bold" Foreground="#DC2626"/>
                <TextBlock Text="(Productos en su límite mínimo o agotados)" VerticalAlignment="Bottom" Margin="10,0,0,4" Foreground="#6B7280" FontSize="14"/>
            </StackPanel>
            <Button Content="🔄 Actualizar" HorizontalAlignment="Right" Click="BtnActualizar_Click" Background="#3B82F6" Foreground="White" Padding="15,5" Cursor="Hand" FontWeight="Bold"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <lvc:CartesianChart 
                Series="{Binding Series}" 
                YAxes="{Binding YAxes}"
                XAxes="{Binding XAxes}"
                TooltipPosition="Right"
                LegendPosition="Hidden">
            </lvc:CartesianChart>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="1">
            <DataGrid x:Name="DgStockCritico" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" 
                      RowHeight="35" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FEF2F2"/>
                        <Setter Property="Foreground" Value="#991B1B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Grado / Categoría" Binding="{Binding GradoNombre}" Width="150"/>
                    <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding Descripcion}" Width="*"/>

                    <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding StockMinimo}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#F59E0B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Faltante" Binding="{Binding Faltante}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>