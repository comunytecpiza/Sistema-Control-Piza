<Window x:Class="AplicativoDeAlmacen.Views.AsignarCodigoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignación de Códigos por Rango" 
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SELECTOR DE TIPO DE LIBRO -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="rbLibroGuia" Content="📘 Libro Guía (Docente)" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,25,0" Cursor="Hand"/>
                <RadioButton x:Name="rbLibroVenta" Content="📙 Libro Venta (Alumno)" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- PANEL DE RANGOS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">

                <!-- Cantidad -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Unidades:" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtSubCantidad" Grid.Column="1" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="8,0" FontWeight="Black" FontSize="14" BorderBrush="#CBD5E1"/>
                </Grid>

                <!-- Desde -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Desde:" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold"/>

                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6" Padding="10,0" Height="34">
                        <TextBlock x:Name="lblPrefijoDesde" Text="G-" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <TextBox x:Name="txtDesde" Grid.Column="2" Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" BorderBrush="#CBD5E1"/>
                </Grid>

                <!-- Hasta -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hasta:" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold"/>

                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1" CornerRadius="6,0,0,6" Padding="10,0" Height="34">
                        <TextBlock x:Name="lblPrefijoHasta" Text="G-" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <TextBox x:Name="txtHasta" Grid.Column="2" Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Foreground="#64748B" FontWeight="Bold" Background="#F8FAFC" BorderBrush="#E2E8F0"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- BOTONES -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAceptarRango" Content="💾 Guardar Rango" Grid.Column="0" Height="38" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,6,0" Click="BtnGrabarCodigo_Click" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnCancelarRango" Content="❌ Cancelar" Grid.Column="1" Height="38" Background="#64748B" Foreground="White" FontWeight="Bold" Margin="6,0,0,0" Click="BtnCancelarRango_Click" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>