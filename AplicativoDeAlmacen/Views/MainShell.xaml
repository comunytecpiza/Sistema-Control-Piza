<Window x:Class="AplicativoDeAlmacen.Views.MainShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:dash="clr-namespace:AplicativoDeAlmacen.Views.Dashboards"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Panel de Administrador - Ediciones Piza" 
        Height="750" Width="1200"
        MinWidth="1050" MinHeight="650"
        WindowState="Maximized" 
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F3F4F6">
    
    <Window.Resources>
        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItemStyle}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="12,8" Margin="0,0,4,0" Background="#E5E7EB" 
                        BorderBrush="#D1D5DB" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>

                                <Setter TargetName="Border" Property="Margin" Value="0,-2,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,2" Panel.ZIndex="10" Padding="10,5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.03"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu x:Name="MenuPrincipal" DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                </Menu>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">

                    <!-- 🔔 1. CONTENEDOR DE LA BANDEJA DE TRANSACCIONES / NOTIFICACIONES -->
                    <!-- 🔔 1. CONTENEDOR DE LA BANDEJA DE NOTIFICACIONES -->
                    <Grid Margin="0,0,15,0" Cursor="">
                        <Grid.Resources>
                            <!-- 🌟 Animación de Parpadeo Verde para Nuevas Transferencias -->
                            <Storyboard x:Key="BlinkGreenStoryboard" RepeatBehavior="Forever">
                                <ColorAnimation Storyboard.TargetName="BordeContador"
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            From="#10B981" To="#059669"
                            Duration="0:0:0.8" AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="BordeContador"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4"
                             Duration="0:0:0.8" AutoReverse="True"/>
                            </Storyboard>
                        </Grid.Resources>

                        <!-- Botón Completo de la Campanita -->
                        <Button x:Name="BtnBandejaTransacciones" 
            Click="BtnBandejaTransacciones_Click"
            Width="42" Height="42" 
            Background="#F3F4F6" 
            BorderBrush="#E5E7EB" 
            BorderThickness="1"
            Cursor="Hand"
            ToolTip="Bandeja de Transferencias Entrantes">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Border x:Name="btnFondo" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="21"/>

                                        <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <Border x:Name="BordeContador"
                            IsHitTestVisible="False"
                            Background="#9CA3AF"
                            MinWidth="18" Height="18"
                            CornerRadius="9"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-2,-2,0">
                                            <TextBlock x:Name="TxtConteoNotificaciones"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnFondo" Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- POPUP FLOTANTE DE NOTIFICACIONES (TIPO TRAY) -->
                        <Popup x:Name="PopupBandeja" 
           PlacementTarget="{Binding ElementName=BtnBandejaTransacciones}" 
           Placement="Bottom" 
           StaysOpen="False" 
           AllowsTransparency="True" 
           PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Width="380" MaxHeight="480" Margin="0,5,10,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="Black" Opacity="0.12"/>
                                </Border.Effect>

                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cabecera -->
                                    <Border Grid.Row="0" Margin="4,4,4,12" Padding="12,10">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="📦 Transferencias Entrantes" FontWeight="Bold" FontSize="14" Foreground="#111827" VerticalAlignment="Center"/>
                                            <Button Content="🔄" Click="BtnRefrescarBandeja_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Actualizar"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Lista de Items -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                        <ItemsControl x:Name="LstTransaccionesBandeja">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EsPendiente}" Value="False">
                                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Fila 1: Guía y Estado -->
                                                            <DockPanel Grid.Row="0">
                                                                <TextBlock Text="{Binding GuiaRemision}" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                                                <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding EsPendiente}" Value="False">
                                                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="⏳ Por Recepcionar"/>
                                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EsPendiente}" Value="False">
                                                                                        <Setter Property="Text" Value="✅ Recibido"/>
                                                                                        <Setter Property="Foreground" Value="#4B5563"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </DockPanel>

                                                            <!-- Fila 2: Origen y Fecha -->
                                                            <StackPanel Grid.Row="1" Margin="0,6,0,6">
                                                                <TextBlock FontSize="12" Foreground="#4B5563">
                                                <Run Text="Origen: " FontWeight="SemiBold"/>
                                                <Run Text="{Binding AlmacenOrigenNombre}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                                <Run Text="📦 "/>
                                                <Run Text="{Binding TotalProductos}"/>
                                                <Run Text=" Prod. ("/>
                                                <Run Text="{Binding TotalCodigos}"/>
                                                <Run Text=" cód) · "/>
                                                <Run Text="{Binding FechaMovimiento, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <!-- Fila 3: Acciones -->
                                                            <Button Grid.Row="2" 
                                                Content="📥 Ver / Recepcionar" 
                                                Tag="{Binding}" 
                                                Click="BtnAtenderTransferencia_Click" 
                                                Height="28" FontSize="11" FontWeight="SemiBold" 
                                                Background="#2563EB" Foreground="White" 
                                                BorderThickness="0" Cursor="Hand" Margin="0,4,0,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Pie del Popup -->
                                    <Border Grid.Row="2" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                        <TextBlock Text="Bandeja de Entradas en Tiempo Real" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock x:Name="WelcomeMessage" Text="Bienvenido(a) Administrador" Foreground="#111827" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                    <Border Width="36" Height="36" CornerRadius="18" Background="#DC2626" Margin="15,0,0,0">
                        <TextBlock x:Name="UserRoleIcon" Text="👑" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="20,10,20,20" Background="Transparent" BorderThickness="0">
            <TabItem Header="🏠 Panel Principal" x:Name="TabInicio">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.05"/>
                        </Border.Effect>

                        <dash:DashboardPrincipalUserControl />

                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.05"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="📝 Mis Notas" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="Organiza tus pendientes diarios" FontSize="12" Foreground="#9CA3AF"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,8,0" Background="#F9FAFB">
                                    <TextBox x:Name="TxtNuevaNota" Padding="8" BorderThickness="0" Background="Transparent" Foreground="#374151"/>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="8" Background="#3B82F6">
                                    <Button Content="+" Click="BtnAgregarNota_Click" Background="Transparent" Foreground="White" FontWeight="Bold" Width="40" Cursor="Hand" BorderThickness="0"/>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Pendientes" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                                    <ListBox x:Name="LbNotasPendientes" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsCompleted}" Click="CheckBox_CambioEstado" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#374151" FontSize="13"/>
                                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="BtnEliminarNota_Click" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Completadas" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,15,0,8"/>
                                    <ListBox x:Name="LbNotasCompletadas" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F9FAFB" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#F3F4F6" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsCompleted}" Click="CheckBox_CambioEstado" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Texto}" TextDecorations="Strikethrough" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="13"/>
                                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="BtnEliminarNota_Click" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#1F2937" Padding="20,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📍" Foreground="#9CA3AF" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- 🌟 COMBOBOX DINÁMICO DE CAMBIO DE ALMACÉN EN CALIENTE -->
                    <!-- 🌟 COMBOBOX DE ALMACÉN COMPACTO (BORDE Y FLECHA AJUSTADOS EXACTAMENTE AL TEXTO) -->
                    <ComboBox x:Name="CboAlmacenBarra" 
          ItemsSource="{Binding AlmacenesPermitidos}" 
          SelectedValuePath="Id"
          SelectionChanged="CboAlmacenBarra_SelectionChanged"
          Height="32" FontSize="13" FontWeight="SemiBold"
          Cursor="Hand"
          HorizontalAlignment="Left"
          ToolTip="Cambiar de almacén activo">

                        <!-- 1. Plantilla del Ítem dentro del Menú -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" 
                       Foreground="#F1F5F9" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" 
                       Margin="4,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <!-- 2. Fondo y Estilo del Desplegable (Popup) -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="2,1">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3B82F6"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                        <!-- 3. Plantilla Compacta: [Texto + Flecha pegada al final] -->
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid HorizontalAlignment="Left">
                                    <!-- Botón de Fondo que envuelve el contenido de forma compacta -->
                                    <ToggleButton x:Name="ToggleButton" 
                              Focusable="False" 
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                              ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="BtnBorder" 
                                    Background="#374151" 
                                    BorderBrush="#4B5563" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,0,10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Texto Seleccionado -->
                                                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" 
                                                      ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                                        <!-- Flecha siempre pegada al final de la palabra -->
                                                        <Path x:Name="Arrow" 
                                          Fill="#9CA3AF" 
                                          VerticalAlignment="Center" 
                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                          Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#4B5563"/>
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#6B7280"/>
                                                        <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Popup que despliega la lista con ancho suficiente -->
                                    <Popup x:Name="Popup" 
                       Placement="Top" 
                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                       AllowsTransparency="True" 
                       Focusable="False" 
                       PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" 
                          SnapsToDevicePixels="True" 
                          MinWidth="240" 
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" 
                                Background="#1E293B" 
                                BorderBrush="#4B5563" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="4" 
                                Margin="0,0,0,4">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="90" Color="Black" Opacity="0.3"/>
                                                </Border.Effect>
                                                <ScrollViewer SnapsToDevicePixels="True">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ComboBox.Template>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="🕒" Foreground="#9CA3AF" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DateTimeTextBlock" FontSize="14" Foreground="#E5E7EB" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 
            Growl global de la aplicación.
            Se declara aquí, una sola vez, en la ventana raíz (MainShell).
            Grid.RowSpan="3" hace que ocupe las 3 filas del Grid principal,
            así puede posicionarse libremente sin quedar limitado por la
            fila "Auto" del header. Panel.ZIndex alto asegura que flote
            por encima del TabControl y de cualquier vista hija (incluyendo
            ConfiguracionSistemaUserControl y cualquier otro UserControl
            que se cargue dentro de las pestañas).
            Todos los Growl.Success/Warning/Error/Info que se llamen desde
            cualquier UserControl hijo de esta ventana se mostrarán aquí.
        -->
    </Grid>
</Window>
