<UserControl x:Class="AplicativoDeAlmacen.Views.SistemaInterno.AuditoriaControlUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="850"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F8FAFC" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Sombras sutiles limpias -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Color="#0F172A" Opacity="0.05"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="8" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>

        <!-- Inputs Corporativos -->
        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones Modernos -->
        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Pestañas Modernas -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,10,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO PRINCIPAL -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16" Effect="{StaticResource HeaderShadow}">
            <DockPanel LastChildFill="True">
                <Border Width="4" Height="40" Background="#2563EB" CornerRadius="2" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Centro de Auditoría, Ciberseguridad &amp; Telemetría TI" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Módulo Seguro" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Control de sesiones concurrentes, prevención de fuerza bruta y gestión de perímetros de red" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Refrescar Todo" Click="BtnRefrescarTodo_Click" Style="{StaticResource BtnAction}" Background="#0F172A" Padding="14,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- TARJETAS DE RESUMEN EJECUTIVO (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Sesiones Activas -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CardShadow}">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SESIONES EN VIVO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblTotalSesiones" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#ECFDF5" CornerRadius="20" Width="40" Height="40">
                        <TextBlock Text="🟢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- KPI 2: Sedes Registradas -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CardShadow}">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SEDES AUTORIZADAS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblTotalSedes" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#EFF6FF" CornerRadius="20" Width="40" Height="40">
                        <TextBlock Text="🏢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- KPI 3: Cuentas Bloqueadas -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CardShadow}">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BLOQUEOS TEMPORALES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblTotalBloqueos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#FEF2F2" CornerRadius="20" Width="40" Height="40">
                        <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- PANEL DE PESTAÑAS PRINCIPALES -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CardShadow}">
            <TabControl BorderThickness="0" Background="Transparent">

                <!-- ==================================================== -->
                <!-- PESTAÑA 1: SESIONES ACTIVAS EN TIEMPO REAL -->
                <!-- ==================================================== -->
                <TabItem Header="👥 Sesiones Conectadas (En Vivo)" Style="{StaticResource ModernTabItem}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Terminales con el sistema abierto actualmente (actualización automática vía Heartbeat)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid x:Name="dgSesionesActivas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#E2E8F0" Foreground="#0F172A" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" FontWeight="Bold" Width="120"/>
                                <DataGridTextColumn Header="ROL" Binding="{Binding Rol}" Width="110"/>
                                <DataGridTextColumn Header="UBICACIÓN / SEDE" Binding="{Binding TipoRed}" Width="160"/>
                                <DataGridTextColumn Header="EQUIPO (PC)" Binding="{Binding NombrePc}" Width="140"/>
                                <DataGridTextColumn Header="USUARIO WINDOWS" Binding="{Binding UsuarioWindows}" Width="130"/>
                                <DataGridTextColumn Header="IP LOCAL" Binding="{Binding IpLocal}" Width="110"/>
                                <DataGridTextColumn Header="IP PÚBLICA" Binding="{Binding IpPublica}" Width="120"/>
                                <DataGridTextColumn Header="HORA LOGIN" Binding="{Binding InicioSesion, StringFormat='dd/MM HH:mm:ss'}" Width="120"/>
                                <DataGridTemplateColumn Header="ACCIÓN TI" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⛔ Expulsar" Click="BtnExpulsarSesion_Click" 
                                                    Background="#EF4444" Foreground="White" FontWeight="Bold" 
                                                    BorderThickness="0" Padding="8,4" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ==================================================== -->
                <!-- PESTAÑA 2: GESTIÓN DE SEDES E IPS AUTORIZADAS -->
                <!-- ==================================================== -->
                <TabItem Header="🏢 Sedes &amp; IPs Públicas" Style="{StaticResource ModernTabItem}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- FORMULARIO DE REGISTRO DE IP -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre de la Sede / Oficina:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="txtNombreSede" Grid.Row="2" Grid.Column="0" Height="34" Style="{StaticResource CleanTextBox}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="IP Pública del Router:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="txtIpPublicaSede" Grid.Row="2" Grid.Column="2" Height="34" Style="{StaticResource CleanTextBox}"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Descripción / Notas:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="txtDescripcionSede" Grid.Row="2" Grid.Column="4" Height="34" Style="{StaticResource CleanTextBox}"/>

                                <Button x:Name="btnDetectarMiIp" Grid.Row="2" Grid.Column="6" Content="🎯 Mi IP Actual" Click="BtnDetectarMiIp_Click" Style="{StaticResource BtnAction}" Background="#0284C7" Height="34"/>
                                <Button x:Name="btnGuardarSede" Grid.Row="2" Grid.Column="8" Content="💾 Guardar Sede" Click="BtnGuardarSede_Click" Style="{StaticResource BtnAction}" Background="#10B981" Height="34"/>
                            </Grid>
                        </Border>

                        <!-- GRILLA DE SEDES REGISTRADAS -->
                        <DataGrid x:Name="dgSedesIps" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#E2E8F0" Foreground="#0F172A" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOMBRE DE SEDE" Binding="{Binding NombreSede}" FontWeight="Bold" Width="200"/>
                                <DataGridTextColumn Header="IP PÚBLICA AUTORIZADA" Binding="{Binding IpPublica}" Width="180"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="FECHA ALTA" Binding="{Binding FechaRegistro, StringFormat='dd/MM/yyyy'}" Width="110"/>
                                <DataGridTemplateColumn Header="ACCIONES" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️ Eliminar" Click="BtnEliminarSede_Click" 
                                                    Background="#EF4444" Foreground="White" FontWeight="SemiBold" 
                                                    BorderThickness="0" Padding="6,3" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ==================================================== -->
                <!-- PESTAÑA 3: BITÁCORA HISTÓRICA & BLOQUEOS -->
                <!-- ==================================================== -->
                <TabItem Header="📋 Bitácora &amp; Bloqueos de Seguridad" Style="{StaticResource ModernTabItem}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- FILTROS Y DESBLOQUEO RÁPIDO -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Registro cronológico de intentos, bloqueos y accesos autorizados." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                            <!-- ⬇️ REEMPLAZA O PEGA ESTO AQUÍ: -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📥 Exportar Log a TXT" Click="BtnExportarTxt_Click" Style="{StaticResource BtnAction}" Background="#2563EB" Height="30" Margin="0,0,8,0"/>
                                <Button Content="🔓 Limpiar Bloqueos" Click="BtnLimpiarBloqueos_Click" Style="{StaticResource BtnAction}" Background="#D97706" Height="30"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="dgAuditoriaHistorial" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#E2E8F0" Foreground="#0F172A" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA Y HORA" Binding="{Binding FechaRegistro, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="150"/>
                                <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" FontWeight="Bold" Width="120"/>
                                <DataGridTextColumn Header="EVENTO" Binding="{Binding Evento}" Width="150"/>
                                <DataGridTextColumn Header="UBICACIÓN" Binding="{Binding TipoRed}" Width="150"/>
                                <DataGridTextColumn Header="EQUIPO (PC)" Binding="{Binding NombrePc}" Width="130"/>
                                <DataGridTextColumn Header="IP LOCAL / PÚBLICA" Binding="{Binding IpLocal}" Width="120"/>
                                <DataGridTextColumn Header="DETALLES" Binding="{Binding Detalles}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</UserControl>