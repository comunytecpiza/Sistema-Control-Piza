<UserControl x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Reporte.contabilidad.HistorialPorContabilidadUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1250" Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <TextBlock Text="📑 Historial Contable y Trazabilidad por Código"
                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

        <!-- SECCIÓN SUPERIOR: FILTROS + DATOS REGISTRO DE VENTAS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- CAJA IZQUIERDA: BÚSQUEDA DEL CÓDIGO -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Producto :" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtProducto" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,2,6,2" TextChanged="TxtProducto_TextChanged"/>
                    <TextBox x:Name="TxtIdProducto" Grid.Row="0" Grid.Column="2" Height="30" VerticalContentAlignment="Center" Margin="0,2,0,2" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" TextAlignment="Center"/>

                    <Popup x:Name="PopupResultados" PlacementTarget="{Binding ElementName=TxtProducto}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" MaxHeight="180" Width="400" CornerRadius="4">
                            <ListBox x:Name="LbProducto" SelectionChanged="LbProducto_SelectionChanged" DisplayMemberPath="Descripcion"/>
                        </Border>
                    </Popup>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo :" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="RbLibroGuia" Content="Libro Guía (Docente)" Margin="0,0,16,0" Checked="RbLibroGuia_Checked"/>
                        <RadioButton x:Name="RbLibroVenta" Content="Libro Venta (Alumno)" Checked="RbLibroVenta_Checked"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Código :" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox x:Name="TxtCodigoEscaneado" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,6,6,0" KeyDown="TxtCodigoEscaneado_KeyDown"/>
                    <TextBox x:Name="TxtAbreviatura" Grid.Row="2" Grid.Column="2" Height="30" VerticalContentAlignment="Center" Margin="0,6,0,0" IsReadOnly="True" Background="#F1F5F9" TextAlignment="Center" FontWeight="SemiBold"/>

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnLector" Content="🔍 Escanear" Background="#8B5CF6" Foreground="White" Width="95" Height="30" Margin="0,0,6,0" Click="BtnLector_Click"/>
                        <Button x:Name="BtnConsultar" Content="⚡ Consultar" Background="#2563EB" Foreground="White" Width="95" Height="30" Margin="0,0,6,0" Click="BtnConsultar_Click"/>
                        <Button x:Name="BtnLimpiar" Content="🧹 Limpiar" Background="#64748B" Foreground="White" Width="85" Height="30" Click="BtnLimpiar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CAJA DERECHA: DATOS REGISTRO DE VENTAS -->
            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="DATOS REGISTRO DE VENTAS" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cliente :" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtClienteVenta" Grid.Row="1" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,2,0,4" IsReadOnly="True" Background="White"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Colegio / Sede :" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtColegioVenta" Grid.Row="2" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,2,0,4" IsReadOnly="True" Background="White"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Comprobante :" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtComprobanteVenta" Grid.Row="3" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,2,0,4" IsReadOnly="True" Background="White" FontWeight="Bold" Foreground="#15803D"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Medio Pago :" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMedioPagoVenta" Grid.Row="4" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,2,0,2" IsReadOnly="True" Background="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- SECCIÓN INFERIOR: PESTAÑAS (GRILLA COMPLETA IDÉNTICA A LA ORIGINAL) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- PESTAÑA 1: KÁRDEX FÍSICO CON TODAS SUS 11 COLUMNAS EXACTAS -->
                <TabItem Header="📦 Movimientos de Almacén (Kárdex Físico)" FontWeight="SemiBold" FontSize="13">
                    <DataGrid x:Name="DgKardexFisico" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6,0,0"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- 1. FECHA MOVIMIENTO -->
                            <DataGridTextColumn Header="FECHA MOV." Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="125"/>

                            <!-- 2. FECHA CREACIÓN -->
                            <DataGridTextColumn Header="FECHA CREACIÓN" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="135"/>

                            <!-- 3. USUARIO CREÓ -->
                            <DataGridTextColumn Header="USUARIO CREÓ" Binding="{Binding UsuarioCreador}" Width="130"/>

                            <!-- 4. FECHA MODIF. -->
                            <DataGridTextColumn Header="FECHA MODIF." Binding="{Binding UpdatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>

                            <!-- 5. USUARIO MODIF. -->
                            <DataGridTextColumn Header="USUARIO MODIF." Binding="{Binding UsuarioModificador}" Width="130"/>

                            <!-- 6. COMPROBANTE / N° REGISTRO -->
                            <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding Registro}" Width="120"/>

                            <!-- 7. GUÍA DE REMISIÓN -->
                            <DataGridTextColumn Header="GUÍA" Binding="{Binding Guia}" Width="110"/>

                            <!-- 8. MOTIVO / TIPO -->
                            <DataGridTextColumn Header="MOTIVO / TIPO" Binding="{Binding Tipo}" Width="210"/>

                            <!-- 9. ENTIDAD / UBICACIÓN / ALMACÉN -->
                            <DataGridTextColumn Header="ENTIDAD / UBICACIÓN / ALMACÉN" Binding="{Binding RazonSocialUbicacion}" Width="*"/>

                            <!-- 10. INGRESO -->
                            <DataGridTextColumn Header="INGRESO" Binding="{Binding IngresoNormal, StringFormat='N2'}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 11. SALIDA -->
                            <DataGridTextColumn Header="SALIDA" Binding="{Binding SalidaNormal, StringFormat='N2'}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- PESTAÑA 2: CONTABILIDAD Y PAGOS -->
                <TabItem Header="📑 Detalle Contable y Pagos" FontWeight="SemiBold" FontSize="13">
                    <DataGrid x:Name="DgPagosFiscales" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6,0,0"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CANAL / MEDIO DE PAGO" Binding="{Binding MedioPago}" Width="240"/>
                            <DataGridTextColumn Header="MONTO (S/)" Binding="{Binding Monto, StringFormat='N2'}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="N° OPERACIÓN" Binding="{Binding NumeroOperacion}" Width="160"/>
                            <DataGridTextColumn Header="GLOSA / OBSERVACIÓN" Binding="{Binding Observacion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>