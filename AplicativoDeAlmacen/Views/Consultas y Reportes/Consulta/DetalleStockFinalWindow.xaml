<Window x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Consulta.DetalleStockFinalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Stock Final en Almacén" Height="620" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🏷️ CABECERA DE PRODUCTO -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📦 PRODUCTO EN STOCK" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                <TextBlock x:Name="TxtNombreProducto" Text="Cargando producto..." FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtFechaCorte" Text="Fecha de corte: --/--/----" FontSize="13" Foreground="#4B5563" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 📊 GRILLAS DIVIDIDAS (Izquierda: Operativos | Derecha: Mermas / Dañados) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 📘 IZQUIERDA: LIBROS OPERATIVOS (Guías y Ventas Disponibles) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#047857" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="🟢 Libros Operativos (Guía y Venta)" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="GridOperativos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              BorderThickness="0" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO ÚNICO" Binding="{Binding CodigoUnico}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TipoCategoria}" Width="90"/>
                            <DataGridTextColumn Header="CONDICIÓN" Binding="{Binding NombreCondicion}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 🔴 DERECHA: LIBROS RESTRINGIDOS (Mermas / Dañados / Perdidos) -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#B91C1C" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="🔴 Libros con Restricción (Merma / Perdidos)" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="GridRestringidos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              BorderThickness="0" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO ÚNICO" Binding="{Binding CodigoUnico}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TipoCategoria}" Width="90"/>
                            <DataGridTextColumn Header="CONDICIÓN ESPECÍFICA" Binding="{Binding NombreCondicion}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 🧮 PANEL INFERIOR DE TOTALES -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <UniformGrid Columns="4">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📘 Total Guías" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalGuias" Text="0" FontSize="18" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📙 Total Ventas" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalVentas" Text="0" FontSize="18" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Restringidos (Merma)" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalRestringidos" Text="0" FontSize="18" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆 STOCK TOTAL" FontSize="12" Foreground="#6B7280" FontWeight="Bold"/>
                    <TextBlock x:Name="LblStockTotal" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- 🔘 BOTONES DE ACCIÓN -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnImprimir" Content="🖨️ Exportar a Excel" Width="150" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnImprimir_Click" Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="🚪 Cerrar" Width="110" Height="40" Background="#EF4444" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCerrar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>