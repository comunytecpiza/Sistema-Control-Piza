<Window x:Class="AplicativoDeAlmacen.Views.Sistema_Interno.ModuloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Módulo" 
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner" 
        Background="#F8FAFC" FontFamily="Segoe UI" 
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🧩 Edición de Módulo" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre del Módulo:" Foreground="#475569" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="TxtNombre" Padding="10,8" Margin="0,6,0,14" FontSize="13" BorderBrush="#CBD5E1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Código Único (Ej: MOD_VENTAS):" Foreground="#475569" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="TxtCodigo" Padding="10,8" Margin="0,6,0,14" CharacterCasing="Upper" FontSize="13" BorderBrush="#CBD5E1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Categoría:" Foreground="#475569" FontWeight="SemiBold" FontSize="12"/>
                <ComboBox x:Name="CboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="Id" 
                          Padding="8" Margin="0,6,0,14" Height="38" FontSize="13" 
                          SelectionChanged="CboCategoria_SelectionChanged"/>

                <TextBlock Text="Orden de Visualización:" Foreground="#475569" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="TxtOrden" Padding="10,8" Margin="0,6,0,10" FontSize="13" BorderBrush="#CBD5E1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTONERA FIJA INFERIOR -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Button Content="💾 Guardar Cambios" Height="42" Background="#10B981" Foreground="White" FontWeight="Bold" 
                    FontSize="13.5" Cursor="Hand" BorderThickness="0" Click="BtnGuardar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Border>
    </Grid>
</Window>