<UserControl x:Class="AplicativoDeAlmacen.Views.Importaciones.ImportarVentasNisiraUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- Cabecera de DataGrid Ejecutiva / Profesional -->
        <Style x:Key="CorporateHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Cabecera Centrada para Números / Cantidades -->
        <Style x:Key="CorporateHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CorporateHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo Visual para Filas Validadas / Con Inconsistencias -->
        <Style x:Key="RowValidationStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <DataTrigger Binding="{Binding EsValido}" Value="False">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                    <Setter Property="ToolTip" Value="{Binding MensajeError}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botones de la Barra Superior -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior: Selección y Acciones -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Archivo de Importación:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                        <TextBox x:Name="TxtRutaArchivo" Width="400" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="8,4" VerticalContentAlignment="Center" Foreground="#1E293B"/>
                    </Border>
                    <Button x:Name="BtnBuscarArchivo" Content="Examinar..." Click="BtnBuscarArchivo_Click" Style="{StaticResource SecondaryActionBtn}" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEjecutar" Click="BtnEjecutar_Click" Style="{StaticResource SecondaryActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0"/>
                            <TextBlock Text="Cargar y Validar"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTransferir" Click="BtnTransferir_Click" IsEnabled="False" Style="{StaticResource PrimaryActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Transferir al Sistema"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSalir" Click="BtnSalir_Click" Style="{StaticResource SecondaryActionBtn}" BorderBrush="#FECACA" Foreground="#B91C1C">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" Margin="0,0,6,0"/>
                            <TextBlock Text="Cerrar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grilla 1: Cabeceras de Facturación -->
        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True">
            <DataGrid x:Name="DgCabeceras" AutoGenerateColumns="False" CanUserAddRows="False" 
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                      ColumnHeaderStyle="{StaticResource CorporateHeaderStyle}"
                      RowStyle="{StaticResource RowValidationStyle}"
                      SelectionChanged="DgCabeceras_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoExcel}" Width="95"/>
                    <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="65" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}"/>
                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="85" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="95" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}"/>
                    <DataGridTextColumn Header="Razón Social (Excel)" Binding="{Binding RazonSocialExcel}" Width="2*"/>
                    <DataGridTextColumn Header="Razón Social (Sistema)" Binding="{Binding RazonSocialSistema}" Width="2*" FontWeight="Medium" Foreground="#1E40AF"/>
                    <DataGridTextColumn Header="Cliente (Excel)" Binding="{Binding ClienteExcel}" Width="1.5*"/>
                    <DataGridTextColumn Header="Cliente (Sistema)" Binding="{Binding ClienteSistema}" Width="1.5*"/>
                    <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="75" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}"/>
                    <DataGridTextColumn Header="Afecto" Binding="{Binding Afecto, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Exonerado" Binding="{Binding Exonerado, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="IGV" Binding="{Binding IGV, StringFormat=N2}" Width="75"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="95" FontWeight="SemiBold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,4"/>

        <!-- Región Inferior: Artículos y Series -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Grilla 2: Detalles (Ítems del comprobante) -->
            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True">
                <DataGrid x:Name="DgDetalles" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource CorporateHeaderStyle}"
                          RowStyle="{StaticResource RowValidationStyle}"
                          SelectionChanged="DgDetalles_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción (Excel)" Binding="{Binding DescripcionExcel}" Width="2*"/>
                        <DataGridTextColumn Header="Descripción (Sistema)" Binding="{Binding DescripcionSistema}" Width="2*" FontWeight="Medium" Foreground="#1E40AF"/>
                        <DataGridTextColumn Header="U.M." Binding="{Binding UnidadMedida}" Width="65" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="P. Unitario" Binding="{Binding PrecioUnitario, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="100" FontWeight="SemiBold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Margin="2,0"/>

            <!-- Grilla 3: Códigos Físicos de Kárdex -->
            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True">
                <DataGrid x:Name="DgCodigos" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource CorporateHeaderStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="26"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsValido}" Value="False">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Setter Property="ToolTip" Value="{Binding MensajeValidacion}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EsValido}" Value="True">
                                    <Setter Property="Foreground" Value="#166534"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55" IsReadOnly="True" HeaderStyle="{StaticResource CorporateHeaderCenterStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Código (Sistema)" Binding="{Binding CodigoMostrar}" Width="1.4*" FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Validación Kárdex" Binding="{Binding MensajeValidacion}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>