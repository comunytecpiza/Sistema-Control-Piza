<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.AgregarItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Ítem al Comprobante" 
        Height="570" Width="720"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        Background="#F1F5F9" 
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🌟 1. TARJETA SUPERIOR: DATOS DEL PRODUCTO -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Producto y Código -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Producto / Libro:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtProductoBuscador" TextChanged="TxtProductoBuscador_TextChanged" ToolTip="Escriba el nombre o código del producto..."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ID:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtProductoId" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Popup de Sugerencias -->
                <Popup x:Name="PopProducto" PlacementTarget="{Binding ElementName=TxtProductoBuscador}" StaysOpen="False" IsOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Effect="{StaticResource CardShadow}">
                        <ListBox x:Name="LstProductos" MaxHeight="160" Width="{Binding ActualWidth, ElementName=TxtProductoBuscador}" SelectionChanged="LstProductos_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Descripcion}" Padding="6,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Fila 2: U. Medida y Afectación -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Unidad Medida:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtUMedida" IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Afectación Tributaria IGV:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtAfectacion" IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 3: Cantidad, P. Unitario y Total -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cantidad Facturada:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtCantidad" Text="0" TextAlignment="Right" TextChanged="Calculo_TextChanged" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Precio Unitario:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtPreUnitario" Text="0.00" TextAlignment="Right" TextChanged="Calculo_TextChanged" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Importe Total:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtTotal" Text="0.00" TextAlignment="Right" IsReadOnly="True" Background="#F0FDF4" Foreground="#166534" FontWeight="Bold" FontSize="13.5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 🌟 2. GRILLA DE CÓDIGOS Y ACCIONES LATERALES -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="135"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla de Códigos -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E293B" Padding="10,6">
                        <TextBlock Text="📋 Códigos / Series Físicas Asignadas" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <DataGrid x:Name="DgCodigos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" RowHeight="26" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                            <DataGridTextColumn Header="Código Físico / QR" Binding="{Binding CodigoString}" Width="2*"/>
                            <DataGridTextColumn Header="Colección / Estado" Binding="{Binding Coleccion}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Panel de Captura Rápida -->
                    <Border x:Name="PanelCapturaCodigo" Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,1,0,0" Padding="10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Código:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#1E3A8A"/>
                            <TextBox x:Name="TxtCapturaCodigo" Grid.Column="1" KeyDown="TxtCapturaCodigo_KeyDown"/>
                            <Button Grid.Column="2" Content="Aceptar" Click="BtnConfirmarCodigo_Click" Width="70" Height="30" Margin="6,0,0,0" Background="#2563EB" Style="{StaticResource ModernButton}"/>
                            <Button Grid.Column="3" Content="Cerrar" Click="BtnCancelarCodigo_Click" Width="65" Height="30" Margin="4,0,0,0" Background="#94A3B8" Style="{StaticResource ModernButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Botones Laterales -->
            <StackPanel Grid.Column="1">
                <Button x:Name="BtnAgregarCod" Content="➕ Digitar" Click="BtnAgregarCod_Click" Height="34" Margin="0,0,0,6" Background="White" Foreground="#2563EB" BorderBrush="#2563EB" BorderThickness="1" IsEnabled="False" Style="{StaticResource ModernButton}"/>
                <Button x:Name="BtnEliminarCod" Content="❌ Quitar" Click="BtnEliminarCod_Click" Height="34" Margin="0,0,0,18" Background="White" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" IsEnabled="False" Style="{StaticResource ModernButton}"/>

                <Button x:Name="BtnGrabarItem" Content="💾 Grabar" Click="BtnGrabarItem_Click" Height="36" Margin="0,0,0,6" Background="#10B981" Style="{StaticResource ModernButton}"/>
                <Button Content="🚪 Cancelar" Click="BtnCerrar_Click" Height="36" Background="#64748B" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>