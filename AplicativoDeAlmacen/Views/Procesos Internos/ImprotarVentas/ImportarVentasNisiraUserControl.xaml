<UserControl x:Class="AplicativoDeAlmacen.Views.Importaciones.ImportarVentasNisiraUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.microsoft.com/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="NisiraHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0E6A5"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValidationStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsValido}" Value="False">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                    <Setter Property="ToolTip" Value="{Binding MensajeError}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Archivo :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtRutaArchivo" Width="350" IsReadOnly="True" VerticalContentAlignment="Center" Background="White" Padding="5,2"/>
                    <Button x:Name="BtnBuscarArchivo" Content="..." Click="BtnBuscarArchivo_Click" Width="30" Margin="4,0,20,0" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEjecutar" Click="BtnEjecutar_Click" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,5,0"/>
                            <TextBlock Text="Ejecutar" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTransferir" Click="BtnTransferir_Click" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,5,0"/>
                            <TextBlock Text="Transferir" FontWeight="SemiBold" Foreground="#2B6CB0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnModelo" Style="{StaticResource ToolbarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="Modelo"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="3" x:Name="BtnSalir" Click="BtnSalir_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Margin="0,0,5,0" Foreground="Red"/>
                        <TextBlock Text="Salir"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#CBD5E0" BorderThickness="1" Background="White">
            <DataGrid x:Name="DgCabeceras" AutoGenerateColumns="False" CanUserAddRows="False" 
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All"
                      ColumnHeaderStyle="{StaticResource NisiraHeaderStyle}"
                      RowStyle="{StaticResource RowValidationStyle}"
                      SelectionChanged="DgCabeceras_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoExcel}" Width="90"/>
                    <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="60"/>
                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="80"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Razón Social (Excel)" Binding="{Binding RazonSocialExcel}" Width="2*"/>
                    <DataGridTextColumn Header="Razón Social (Sistema)" Binding="{Binding RazonSocialSistema}" Width="2*"/>
                    <DataGridTextColumn Header="Cliente (Excel)" Binding="{Binding ClienteExcel}" Width="1.5*"/>
                    <DataGridTextColumn Header="Cliente (Sistema)" Binding="{Binding ClienteSistema}" Width="1.5*"/>
                    <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="70"/>
                    <DataGridTextColumn Header="Afecto" Binding="{Binding Afecto, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="Exonerado" Binding="{Binding Exonerado, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="IGV" Binding="{Binding IGV, StringFormat=N2}" Width="70"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#CBD5E0" Margin="0,5"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CBD5E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="DgDetalles" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All"
                          ColumnHeaderStyle="{StaticResource NisiraHeaderStyle}"
                          SelectionChanged="DgDetalles_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción (Excel)" Binding="{Binding DescripcionExcel}" Width="2*"/>
                        <DataGridTextColumn Header="Descripción (Sistema)" Binding="{Binding DescripcionSistema}" Width="2*"/>
                        <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="80"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                        <DataGridTextColumn Header="P. Unitario" Binding="{Binding PrecioUnitario, StringFormat=N4}" Width="90"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E0" Margin="5,0"/>

            <Border Grid.Column="2" BorderBrush="#CBD5E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="DgCodigos" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          ColumnHeaderStyle="{StaticResource NisiraHeaderStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsValido}" Value="False">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Setter Property="ToolTip" Value="{Binding Error}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="70" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="1"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoExcel}" Width="1.5*"/>
                        <DataGridTextColumn Header="Validación Interna Kardex" Binding="{Binding Error}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>