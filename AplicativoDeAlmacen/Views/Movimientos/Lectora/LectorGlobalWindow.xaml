<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.Lectora.LectorGlobalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lector de Códigos"
        Height="450" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
            <TextBlock Text="Escanee los códigos" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtLector" Height="42" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="TxtLector_KeyDown"/>
        </StackPanel>

        <ListBox Grid.Column="0" Grid.Row="1" Margin="0,15,15,15" x:Name="LstLog" Background="#1E293B" Foreground="#10B981" FontFamily="Consolas"/>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="#FDF2F2" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📊 RESUMEN" FontWeight="Bold" FontSize="15" Foreground="#C62828" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LblStats" Text="Esperando registros..." FontSize="13" FontFamily="Segoe UI" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Height="40" Content="Cerrar" Click="BtnCerrar_Click" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>