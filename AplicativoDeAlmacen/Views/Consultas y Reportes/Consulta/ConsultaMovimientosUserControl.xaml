<UserControl x:Class="AplicativoDeAlmacen.Views.ConsultaMovimientosUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6" 
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="RightAlignStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IngresoStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SalidaStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SaldoStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <!-- 🌟 CONTENEDOR GENERAL CON SCROLL EXTERNO PARA PANTALLAS PEQUEÑAS -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Grid.Row="0" Text="📦 Movimiento por Producto" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>

            <!-- PANEL SUPERIOR DE FILTROS -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <!-- Producto Maestro -->
                        <StackPanel Margin="0,0,15,8">
                            <TextBlock Text="Producto Maestro:" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboProductos" Width="260" Height="36" IsEditable="True" 
                                      StaysOpenOnEdit="True" IsTextSearchEnabled="False"
                                      DisplayMemberPath="Descripcion" TextSearch.TextPath="Descripcion"
                                      SelectionChanged="CboProductos_SelectionChanged" FontSize="13" BorderBrush="#CBD5E1" 
                                      TextBoxBase.TextChanged="TxtProducto_TextChanged"/>
                        </StackPanel>

                        <!-- Fechas -->
                        <StackPanel Margin="0,0,15,8">
                            <TextBlock Text="Fechas (Desde / Hasta)" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker x:Name="DpDesde" Width="115" Height="36" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpHasta" Width="115" Height="36"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Filtros Extra con Autocompletado -->
                        <StackPanel Margin="0,0,15,8">
                            <TextBlock Text="Filtros Extra (Autocompletado):" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Almacén -->
                                <CheckBox x:Name="ChkAlmacen" Content="Almacén:" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Click="ChkFiltros_Click"/>
                                <Grid Margin="0,0,10,0">
                                    <TextBox x:Name="TxtAlmacen" Width="130" Height="34" IsEnabled="False" 
                                             VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CBD5E1"
                                             TextChanged="TxtAlmacen_TextChanged"/>
                                    <Popup x:Name="PopupAlmacen" PlacementTarget="{Binding ElementName=TxtAlmacen}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                            <ListBox x:Name="LstAlmacen" Width="140" MaxHeight="140" BorderThickness="0" 
                                                     DisplayMemberPath="Nombre" 
                                                     SelectionChanged="LstAlmacen_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Razón Social -->
                                <CheckBox x:Name="ChkRazonSocial" Content="Razón Social:" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Click="ChkFiltros_Click"/>
                                <Grid Margin="0,0,10,0">
                                    <TextBox x:Name="TxtRazonSocial" Width="130" Height="34" IsEnabled="False" 
                                             VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CBD5E1"
                                             TextChanged="TxtRazonSocial_TextChanged"/>
                                    <Popup x:Name="PopupRazonSocial" PlacementTarget="{Binding ElementName=TxtRazonSocial}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                            <ListBox x:Name="LstRazonSocial" Width="140" MaxHeight="140" BorderThickness="0" 
                                                     DisplayMemberPath="RazonSocial" 
                                                     SelectionChanged="LstRazonSocial_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Ubicación -->
                                <CheckBox x:Name="ChkUbicacion" Content="Ubicación:" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Click="ChkFiltros_Click"/>
                                <Grid Margin="0,0,10,0">
                                    <TextBox x:Name="TxtUbicacion" Width="130" Height="34" IsEnabled="False" 
                                             VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#CBD5E1"
                                             TextChanged="TxtUbicacion_TextChanged"/>
                                    <Popup x:Name="PopupUbicacion" PlacementTarget="{Binding ElementName=TxtUbicacion}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                            <ListBox x:Name="LstUbicacion" Width="140" MaxHeight="140" BorderThickness="0" 
                                                     DisplayMemberPath="Descripcion" 
                                                     SelectionChanged="LstUbicacion_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <CheckBox x:Name="ChkMostrarAnulados" Content="Mostrar Anulados" VerticalAlignment="Center" Foreground="#DC2626" FontWeight="Bold" Click="ChkMostrarAnulados_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tipo de Operación -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Tipo de Operación:" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RbGuia" Content="Solo Guías" Margin="0,0,10,0" Foreground="#334155" VerticalAlignment="Center" Click="RbFiltro_Click"/>
                                    <RadioButton x:Name="RbVenta" Content="Solo Ventas" Margin="0,0,10,0" Foreground="#334155" VerticalAlignment="Center" Click="RbFiltro_Click"/>
                                    <RadioButton x:Name="RbTodos" Content="Todos" IsChecked="True" Foreground="#334155" VerticalAlignment="Center" FontWeight="Bold" Click="RbFiltro_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Botones de Acción -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAbrirOpcionesImpresion" Content="🖨️ Imprimir" Height="38" Width="100" 
                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnAbrirOpcionesImpresion_Click" IsEnabled="False"/>

                        <Button x:Name="BtnEjecutar" Content="🚀 Ejecutar" Height="38" Width="110" 
                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" 
                                BorderThickness="0" Cursor="Hand" Click="BtnEjecutar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 🌟 SECCIÓN DE TABLAS: ALTURA LIMITADA PARA FORZAR SCROLL INTERNO -->
            <Grid Grid.Row="2" Height="490">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.6*"/>
                    <ColumnDefinition Width="3.4*"/>
                </Grid.ColumnDefinitions>

                <!-- TABLA IZQUIERDA: MOVIMIENTOS -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,12,0" ClipToBounds="True" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#1E293B" Padding="15,10">
                            <TextBlock Text="📋 Libro de Movimientos Contables" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </Border>

                        <!-- GRILLA CON SCROLLBAR VERTICAL INTERNO -->
                        <DataGrid x:Name="MovimientosDataGrid" 
                                  Grid.Row="1" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  BorderThickness="0" 
                                  HeadersVisibility="Column" 
                                  RowHeight="36" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#F1F5F9" 
                                  AlternatingRowBackground="#F8FAFC"
                                  SelectionChanged="MovimientosDataGrid_SelectionChanged" 
                                  SelectedCellsChanged="MovimientosDataGrid_SelectedCellsChanged" 
                                  MouseDoubleClick="MovimientosDataGrid_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAnulado}" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="8,8"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding NumeroRegistro}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="GUÍA" Binding="{Binding NumeroGuia}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ENTIDAD / UBICACIÓN" Binding="{Binding RazonSocialUbicacion}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="8,0,0,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="INGRESO" Binding="{Binding Salida, StringFormat={}{0:N0}}" Width="90" CellStyle="{StaticResource SalidaStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="SALIDA" Binding="{Binding Ingreso, StringFormat={}{0:N0}}" Width="90" CellStyle="{StaticResource IngresoStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="TOTAL EN PODER" Binding="{Binding SaldoAcumulado, StringFormat={}{0:N0}}" Width="120" Visibility="Collapsed" CellStyle="{StaticResource SaldoStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TARJETAS DE TOTALES -->
                        <Border Grid.Row="2" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,1.5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Card1" Grid.Column="0" Background="#ECFDF5" BorderBrush="#34D399" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCard1" Text="Total Entradas" Foreground="#065F46" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtTotalIngreso" Text="0.00" Foreground="#047857" FontWeight="Black" FontSize="18"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="Card2" Grid.Column="1" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCard2" Text="Total Salidas" Foreground="#991B1B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtTotalSalida" Text="0.00" Foreground="#B91C1C" FontWeight="Black" FontSize="18"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="Card3" Grid.Column="2" Background="#EFF6FF" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="8" Padding="10,8" 
                                        Cursor="Hand" MouseLeftButtonUp="CardSaldoEnPoder_Click" ToolTip="Haz clic aquí para ver todos los códigos físicos pendientes en su poder.">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCard3" Text="Saldo Pendiente en Poder" Foreground="#3730A3" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtTotalVendidos" Text="0.00" Foreground="#4338CA" FontWeight="Black" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- TABLA DERECHA: CÓDIGOS -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" ClipToBounds="True" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#4338CA" Padding="15,10">
                            <TextBlock Text="🏷️ Códigos de la Operación" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </Border>

                        <!-- GRILLA CON SCROLLBAR VERTICAL INTERNO PARA CÓDIGOS -->
                        <DataGrid x:Name="CodigosDataGrid" 
                                  Grid.Row="1" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  BorderThickness="0" 
                                  HeadersVisibility="Column" 
                                  RowHeight="32" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO QR / FÍSICO" Binding="{Binding Codigo}" Width="*" FontWeight="SemiBold" Foreground="#334155"/>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding ColeccionTipo}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="#F8FAFC" Padding="8" BorderBrush="#E2E8F0" BorderThickness="0,1.5,0,0">
                            <Border Background="#EEF2FF" CornerRadius="6" Padding="8,6" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtTotalCodigos" Text="Seleccione un movimiento" FontWeight="Bold" Foreground="#4F46E5" FontSize="11.5"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>