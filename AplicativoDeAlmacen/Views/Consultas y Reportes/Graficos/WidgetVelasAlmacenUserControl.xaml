<UserControl x:Class="AplicativoDeAlmacen.Views.Consultas_y_Reportes.Graficos.WidgetVelasAlmacenUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTROS PRINCIPALES -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- BUSCADOR DE PRODUCTO -->
                <StackPanel Margin="0,0,12,6" Width="260">
                    <TextBlock Text="Buscar Producto (ID / Nombre):" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBuscarProducto" Height="34" VerticalContentAlignment="Center" TextChanged="TxtBuscarProducto_TextChanged"/>
                    <Popup x:Name="PopupResultados" PlacementTarget="{Binding ElementName=TxtBuscarProducto}" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MaxHeight="180">
                            <ListBox x:Name="LbProducto" Width="{Binding ActualWidth, ElementName=TxtBuscarProducto}" 
                                     DisplayMemberPath="Descripcion"
                                     SelectionChanged="LbProducto_SelectionChanged"
                                     BorderThickness="0"/>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- FECHAS -->
                <StackPanel Margin="0,0,12,6" Width="135">
                    <TextBlock Text="Desde:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDesde" Height="34"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,6" Width="135">
                    <TextBlock Text="Hasta:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpHasta" Height="34"/>
                </StackPanel>

                <!-- PROMOTOR / RAZÓN SOCIAL -->
                <StackPanel Margin="0,0,12,6" Width="190">
                    <TextBlock Text="Promotor / Razón Social:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRazonSocial" Height="34" VerticalContentAlignment="Center" TextChanged="TxtRazonSocial_TextChanged"/>
                    <Popup x:Name="PopupRazonSocial" PlacementTarget="{Binding ElementName=TxtRazonSocial}" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MaxHeight="160">
                            <ListBox x:Name="LstRazonSocial" Width="{Binding ActualWidth, ElementName=TxtRazonSocial}" 
                                     DisplayMemberPath="RazonSocial"
                                     SelectionChanged="LstRazonSocial_SelectionChanged"
                                     BorderThickness="0"/>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- UBICACIÓN -->
                <StackPanel Margin="0,0,12,6" Width="160">
                    <TextBlock Text="Ubicación (ID / Nombre):" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUbicacion" Height="34" VerticalContentAlignment="Center" TextChanged="TxtUbicacion_TextChanged"/>
                    <Popup x:Name="PopupUbicacion" PlacementTarget="{Binding ElementName=TxtUbicacion}" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MaxHeight="160">
                            <ListBox x:Name="LstUbicacion" Width="{Binding ActualWidth, ElementName=TxtUbicacion}" 
                                     DisplayMemberPath="Descripcion"
                                     SelectionChanged="LstUbicacion_SelectionChanged"
                                     BorderThickness="0"/>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- AGRUPACIÓN -->
                <StackPanel Margin="0,0,12,6" Width="140">
                    <TextBlock Text="Periodo:" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboPeriodo" Height="34" SelectedIndex="0">
                        <ComboBoxItem Content="Día / Movimiento"/>
                        <ComboBoxItem Content="Por Semana"/>
                        <ComboBoxItem Content="Por Mes"/>
                    </ComboBox>
                </StackPanel>

                <!-- BOTÓN GENERAR -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Button Content="📊 Generar" Click="BtnEjecutar_Click" 
                            Background="#10B981" Foreground="White" FontWeight="Bold" Width="105" Height="34" 
                            Cursor="Hand"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- GRÁFICO CARTESIANO CON DOBLE CLIC ACTIVO -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <lvc:CartesianChart 
            x:Name="MiGraficoVelas"
            Series="{Binding Series}" 
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            ZoomMode="X"
            TooltipFindingStrategy="CompareAllTakeClosest"
            TooltipPosition="Right"
            MouseDoubleClick="MiGraficoVelas_MouseDoubleClick"/>
        </Border>
    </Grid>
</UserControl>