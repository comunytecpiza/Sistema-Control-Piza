<UserControl x:Class="AplicativoDeAlmacen.Views.SalidasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AplicativoDeAlmacen.Views"
             mc:Ignorable="d" d:DesignWidth="1150"
             Background="#F5F7FA"
             FontFamily="Segoe UI" Height="Auto" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="0" Color="#000000" Opacity="0.08"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.06"/>
        
        <!-- Estilos de TextBlock -->
        <Style x:Key="NoWrapTextBlock" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo de Encabezado Oscuro para DataGrid de Códigos -->
        <Style x:Key="DarkDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO PRINCIPAL -->
            <Border Grid.Row="0" BorderBrush="#DC2626" BorderThickness="4,0,0,0" Padding="16,4,0,4" Margin="0,0,0,24" CornerRadius="0">
                <TextBlock Text="Salida de Productos" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
            </Border>

            <!-- SECCIÓN DE FORMULARIO -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <StackPanel>
                    <!-- BOTONES PRINCIPALES -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="btnNuevo" Style="{StaticResource ModernButton}" Content="➕ Nueva Salida" Background="#3B82F6" Margin="0,0,10,0" MinWidth="130" Click="BtnNuevo_Click"/>
                        <Button x:Name="btnModificarCabecera" Style="{StaticResource ModernButton}" Content="✏️ Modificar" Background="#F59E0B" Margin="0,0,10,0" MinWidth="110" Click="BtnModificar_Click" />
                        <Button x:Name="btnImprimirTicket" Style="{StaticResource ModernButton}" Content="🖨️ Imprimir" Background="#6B7280" Margin="0,0,10,0" MinWidth="120" Click="BtnImprimir_Click"/>
                        <Button x:Name="btnAnularSalida" Style="{StaticResource ModernButton}" Content="🗑️ Anular" Background="#DC2626" MinWidth="110" Click="BtnAnular_Click"/>
                    </StackPanel>

                    <!-- FORMULARIO PRINCIPAL DE SALIDA -->
                    <Border CornerRadius="8" Background="White" Padding="24" Effect="{StaticResource CardShadow}">
                        <Grid x:Name="grdFormularioSalida">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="N° Operación" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <Grid Grid.Column="1" Margin="0,0,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="135*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSerieSalida" Grid.Column="0" Height="36" IsReadOnly="True" FontSize="13" FontWeight="Bold" Background="#F9FAFB" HorizontalContentAlignment="Center"/>
                                <TextBox x:Name="txtNumeroSalida" Grid.Column="2" Height="36" IsReadOnly="True" FontSize="13" FontWeight="Bold" Background="#F9FAFB" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Fecha de Despacho" Grid.Column="2" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <DatePicker x:Name="dtpFechaDespacho" Grid.Column="3" Height="36" Margin="0,0,0,14" FontSize="13" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Motivo Salida" Grid.Row="1" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <ComboBox x:Name="cboMotivoSalida" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="36" Margin="0,0,0,14" FontSize="13" DisplayMemberPath="Descripcion" SelectedValuePath="Id" SelectionChanged="CboMotivoSalida_SelectionChanged" />

                            <TextBlock Text="Cliente / Destino" Grid.Row="2" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,20,14">
                                <TextBox x:Name="txtCliente" Height="36" FontSize="13" Padding="10,6" TextChanged="TxtCliente_TextChanged"/>
                                <Popup x:Name="popupClientes" PlacementTarget="{Binding ElementName=txtCliente}" Placement="Bottom" Width="{Binding ActualWidth, ElementName=txtCliente}" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Effect="{StaticResource CardShadow}">
                                        <ListBox x:Name="lstClientes" MaxHeight="160" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonUp="LstClientes_PreviewMouseLeftButtonUp">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="Transparent">
                                                        <TextBlock Text="{Binding RazonSocial}" FontSize="13" Foreground="#1F2937" Margin="12,8"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Text="Código Cliente" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <TextBox x:Name="txtCodigoCliente" Grid.Row="2" Grid.Column="3" Height="36" Margin="0,0,0,14" IsReadOnly="True" FontSize="13"/>
                            <TextBlock Text="Dirección Cliente" Grid.Row="3" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <TextBox x:Name="txtDireccionCliente" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="36" Margin="0,0,0,14" IsReadOnly="True" FontSize="13"/>

                            <TextBlock Text="Ubicación / Dest" Grid.Row="4" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,20,14">
                                <TextBox x:Name="txtUbicacion" Height="36" FontSize="13" Padding="10,6" TextChanged="TxtUbicacion_TextChanged"/>
                                <Popup x:Name="popupUbicaciones" PlacementTarget="{Binding ElementName=txtUbicacion}" Placement="Bottom" Width="{Binding ActualWidth, ElementName=txtUbicacion}" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                    <Border Background="White" BorderBrush="#E5E5EB" BorderThickness="1" CornerRadius="6" Effect="{StaticResource CardShadow}">
                                        <ListBox x:Name="lstUbicaciones" MaxHeight="160" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonUp="LstUbicaciones_PreviewMouseLeftButtonUp">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="Transparent">
                                                        <TextBlock Text="{Binding Descripcion}" FontSize="13" Foreground="#1F2937" Margin="12,8"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Text="Código Ubicación" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <TextBox x:Name="txtCodigoUbicacion" Grid.Row="4" Grid.Column="3" Height="36" Margin="0,0,0,14" IsReadOnly="True" FontSize="13"/>
                            <TextBlock Text="Dirección Ubic." Grid.Row="5" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <TextBox x:Name="txtDireccionUbicacion" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Height="36" Margin="0,0,0,14" IsReadOnly="True" FontSize="13"/>

                            <TextBlock Text="Almacén Destino" Grid.Row="6" VerticalAlignment="Center" Foreground="#374151" FontWeight="Bold" Margin="0,0,0,14" FontSize="13"/>
                            <ComboBox x:Name="cboAlmacenDestino" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Height="36" Margin="0,0,0,14" FontSize="13" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>

                            <TextBlock Text="# Guía" Grid.Row="7" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,14" FontSize="13"/>
                            <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtSerieGuia" Grid.Column="0" Height="36" FontSize="13" HorizontalContentAlignment="Center"/>
                                <TextBox x:Name="txtNumeroGuia" Grid.Column="2" Height="36" FontSize="13"/>
                            </Grid>

                            <TextBlock Text="Observación" Grid.Row="8" VerticalAlignment="Top" Margin="0,8,0,0" Foreground="#374151" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox x:Name="txtObservacionSalida" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8" FontSize="13"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- SECCIÓN DE ITEMS Y CÓDIGOS -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BOTONES DE ACCIÓN -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <Button x:Name="btnAgregarItem" Style="{StaticResource ModernButton}" Content="+ Agregar" Background="#0EA5E9" Margin="0,0,10,0" MinWidth="100" Click="btnAgregarItem_Click"/>
                        <Button x:Name="btnModificarDetalle" Style="{StaticResource ModernButton}" Content="✏️ Modificar" Background="#F59E0B" Margin="0,0,10,0" MinWidth="110" Click="BtnModificarDetalle_Click"/>
                        <Button x:Name="btnEliminarItem" Style="{StaticResource ModernButton}" Content="🗑️ Eliminar" Background="#DC2626" Margin="0,0,10,0" MinWidth="110" Click="BtnEliminar_Click"/>
                        <Button x:Name="btnImportarExcel" Style="{StaticResource ModernButton}" Content="📊 Importar Excel" Background="#10B981" Margin="0,0,10,0" MinWidth="140" Click="BtnImportarExcel_Click"/>
                        <Button x:Name="btnEscanear" Style="{StaticResource ModernButton}" Content="🔫 Escanear" Background="#8B5CF6" Margin="0,0,10,0" MinWidth="110" Click="BtnEscanear_Click"/>

                        <TextBlock x:Name="lblPorcentajeCarga" Text="0% Guardando..." Foreground="#4F46E5" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="16,0,10,0" Visibility="Collapsed"/>
                        <ProgressBar x:Name="pbCargaMasiva" Width="150" Height="16" VerticalAlignment="Center" Foreground="#4F46E5" Background="#E5E7EB" BorderThickness="0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="btnGrabarSalida" Style="{StaticResource ModernButton}" Content="💾 Procesar Salida" Background="#1F2937" Margin="0,0,10,0" MinWidth="170" Click="btnGrabarSalida_Click" />
                        <Button x:Name="btnCancelar" Style="{StaticResource ModernButton}" Content="❌ Cancelar" Background="#6B7280" MinWidth="115" Click="BtnCancelar_Click"/>
                    </StackPanel>
                </Grid>

                <!-- TABLAS DE DATOS ALINEADAS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TABLA 1: Productos a Despachar -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#DC2626" CornerRadius="6,6,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Productos a Despachar" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="2" Effect="{StaticResource CardShadow}">
                            <DataGrid x:Name="dgProductosSalida" 
                                      IsReadOnly="True" 
                                      SelectionMode="Extended" 
                                      SelectionUnit="FullRow" 
                                      Style="{StaticResource ModernDataGrid}" 
                                      SelectionChanged="DgProductosSalida_SelectionChanged"
                                      MouseDoubleClick="DgProductosSalida_MouseDoubleClick"
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Auto"
                                      FontSize="14" 
                                      CanUserResizeColumns="True" 
                                      MinHeight="300" 
                                      Height="Auto"
                                      VirtualizingPanel.IsVirtualizing="True" 
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True" 
                                      EnableColumnVirtualization="False" 
                                      ScrollViewer.CanContentScroll="True"
                                      RowHeaderWidth="0" 
                                      AutoGenerateColumns="False">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoProducto}" Width="SizeToCells" MinWidth="100" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" MinWidth="220" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="U. MEDIDA" Binding="{Binding UnidadMedida}" Width="SizeToCells" MinWidth="80" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Detalle.CantidadSalida}" Width="SizeToCells" MinWidth="80" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="COSTO UNIT." Width="SizeToCells" MinWidth="90">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Detalle.CostoUnitario" StringFormat="N2" TargetNullValue="0.00" FallbackValue="0.00"/>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- TABLA 2: Códigos Escaneados / Despachados -->
                    <Grid Grid.Column="2" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6,6,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔑" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Códigos Escaneados" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Barra de búsqueda -->
                        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1,0,1,0" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox x:Name="txtBuscarCodigo" 
                                             Height="30" 
                                             Padding="30,0,8,0" 
                                             FontSize="12" 
                                             Background="White" 
                                             BorderBrush="#CBD5E1" 
                                             VerticalContentAlignment="Center" 
                                             TextChanged="TxtBuscarCodigo_TextChanged"/>
                                    <TextBlock Text="🔍" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#64748B" FontSize="12"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrando:" Foreground="#64748B" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="lblResumenCodigos" Text="0 / 0" FontSize="12" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid de Códigos con altura amplia para 25+ filas -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="2" Effect="{StaticResource CardShadow}">
                            <DataGrid x:Name="dgCodigosSalida" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      CanUserAddRows="False"
                                      MinHeight="600"
                                      Height="210"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanUserResizeColumns="True"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                                      RowHeaderWidth="0"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="False"
                                      ScrollViewer.CanContentScroll="True"
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N° Fila" Binding="{Binding NumeroFila}" Width="60" MinWidth="40" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="Código Único" Binding="{Binding CodigoUnique}" Width="*" MinWidth="140" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                    <DataGridTextColumn Header="Tipo de Colección" Binding="{Binding ColeccionTipo}" Width="SizeToCells" MinWidth="110" ElementStyle="{StaticResource NoWrapTextBlock}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>