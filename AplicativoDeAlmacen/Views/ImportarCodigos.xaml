<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AplicativoDeAlmacen.Views.ImportarCodigos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auditoría e Importación Inteligente de Lotes" Height="720" Width="1100" 
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Window.Resources>
        <!-- 🎨 ESTILO PARA HACER EL SCROLLBAR MÁS GRUESO Y VISIBLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="🚀 Asistente de Importación y Mapeo de Códigos por Producto" FontSize="22" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15" Foreground="#1E293B" />

        <!-- 1. SELECCIÓN DE ARCHIVO Y SALUD -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Archivo Excel:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtRutaArchivo" Width="450" Height="35" IsReadOnly="True" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    <Button x:Name="btn_buscar" Content="📂 Explorar Excel" Click="Button_Click" Width="130" Height="35" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>

                <Border Grid.Column="1" x:Name="brdHealth" Background="#F1F5F9" CornerRadius="4" Padding="15,5" BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock x:Name="txtHealth" Text="Esperando archivo..." FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. CONTROLES, FILTRO DE GUÍA/VENTA Y BÚSQUEDA -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chkSeleccionarTodos" Content="Seleccionar Todos los Aptos" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Click="ChkSeleccionarTodos_Click" IsChecked="True"/>

                <!-- 🌟 NUEVO FILTRO POR CATEGORÍA (TODOS / SOLO GUÍA / SOLO VENTA) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="25,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Categoría:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569" Margin="0,0,8,0"/>
                    <RadioButton x:Name="rbFiltroTodos" Content="Todos" IsChecked="True" Checked="FiltroCategoria_Changed" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <RadioButton x:Name="rbFiltroGuia" Content="📘 Solo Guías" Checked="FiltroCategoria_Changed" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <RadioButton x:Name="rbFiltroVenta" Content="📙 Solo Ventas" Checked="FiltroCategoria_Changed" FontWeight="SemiBold" Foreground="#9A3412" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>

                <!-- 🌟 BÚSQUEDA BIVALENTE (POR PRODUCTO O POR CÓDIGO) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Buscar (Producto / Código):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtBuscarCodigo" Width="220" Height="32" Padding="8,0" VerticalContentAlignment="Center" TextChanged="TxtBuscarCodigo_TextChanged" ToolTip="Escriba el nombre de un producto o la serie de un código físico"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. VISTA AGRUPADA CON SCROLL GRUESO Y FLUIDO -->
        <ScrollViewer x:Name="scrollPrincipal" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="lstProductosAgrupados">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" BorderThickness="1" Margin="0,0,10,12" Padding="10" Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <Grid Width="960">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" Click="ChkProductoItem_Click" IsEnabled="{Binding TieneValidos}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductoNombre}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding ResumenDiagnostico}" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="10,4" BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeTexto}" FontWeight="Black" FontSize="12" Foreground="{Binding BadgeColor}"/>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <!-- 🌟 GRILLA INTERNA CON PROPAGACIÓN DE MOUSEWHEEL PARA NO BLOQUEAR EL SCROLL -->
                                <DataGrid ItemsSource="{Binding CodigosInternos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                      Background="White" RowHeight="30" MaxHeight="350" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Código Extraído" Binding="{Binding CodigoRaw}" Width="220" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaTexto}" Width="120" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Diagnóstico Individual" Binding="{Binding ObservacionAuditoria}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstadoValido}" Value="False">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. BARRA INFERIOR -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                <Border Background="#F1F5F9" Padding="15,8" CornerRadius="6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Códigos:" FontWeight="Bold" Foreground="#475569" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtTotalCodigos" Text="0" FontWeight="Black"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECFDF5" Padding="15,8" CornerRadius="6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aptos Seleccionados:" FontWeight="Bold" Foreground="#065F46" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtValidos" Text="0" FontWeight="Black" Foreground="#047857"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF2F2" Padding="15,8" CornerRadius="6" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Errores / Omitidos:" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtInvalidos" Text="0" FontWeight="Black" Foreground="#B91C1C"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="btnSalir" Content="Cancelar" Click="Button_Click_1" Width="100" Height="40" Background="Transparent" Foreground="#64748B" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                <Button x:Name="btnTransferir" Content="Transferir Lote Seleccionado" Click="Button_Click_2" Width="230" Height="40" IsEnabled="False" Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>