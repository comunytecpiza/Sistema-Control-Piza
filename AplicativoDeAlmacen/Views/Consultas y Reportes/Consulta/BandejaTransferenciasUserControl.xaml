<UserControl x:Class="AplicativoDeAlmacen.Views.BandejaTransferenciasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título y Filtros -->
            <RowDefinition Height="*"/>
            <!-- Tabla DataGrid -->
        </Grid.RowDefinitions>

        <!-- 1. BARRA SUPERIOR DE FILTROS Y CONTROL -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" 
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.03"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icono y Título -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <TextBlock Text="🔄" FontSize="18" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Bandeja de Transferencias" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Control e historial de envíos inter-almacén" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,4,20,4" />

                    <!-- Filtro Estado -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Estado" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CboFiltroEstado" Width="140" Height="32" SelectedIndex="0" SelectionChanged="CboFiltroEstado_SelectionChanged">
                            <ComboBoxItem Content="TODOS"/>
                            <ComboBoxItem Content="PENDIENTES"/>
                            <ComboBoxItem Content="RECEPCIONADOS"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Fechas -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Desde" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DtpDesde" Width="120" Height="32"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Hasta" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DtpHasta" Width="120" Height="32"/>
                    </StackPanel>

                    <!-- Botón Buscar -->
                    <Button Content="🔍 Buscar" Click="BtnBuscar_Click" Width="90" Height="32" 
                            Background="#2563EB" Foreground="White" FontWeight="Bold" 
                            Cursor="Hand" BorderThickness="0" VerticalAlignment="Bottom">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Botón Refrescar -->
                <Button Grid.Column="1" Content="🔄 Refrescar" Click="BtnRefrescar_Click" Height="32" Padding="14,0" 
                        Background="#F9FAFB" Foreground="#374151" FontWeight="SemiBold" 
                        Cursor="Hand" BorderBrush="#D1D5DB" BorderThickness="1" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 2. DATAGRID DE TRANSFERENCIAS -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="DgTransferencias" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0"
                      FontSize="13" ColumnHeaderHeight="40" RowHeight="46">

                <DataGrid.Resources>
                    <!-- Estilo de Cabeceras -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#4B5563"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="SeparatorBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- TIPO Y ROL EN LA TRANSACCIÓN (📤 Enviado / 📥 Por Recibir) -->
                    <DataGridTemplateColumn Header="OPERACIÓN" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoyElEmisor}" Value="False">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📤 ENVIADO"/>
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SoyElEmisor}" Value="False">
                                                        <Setter Property="Text" Value="📥 RECIBIDO"/>
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- GUÍA DE REMISIÓN (DATO PRINCIPAL QUE CONECTA A AMBOS) -->
                    <DataGridTextColumn Header="GUÍA REMISIÓN" Binding="{Binding GuiaRemision}" Width="130" FontWeight="Bold"/>

                    <!-- DOCUMENTO / REGISTRO INTERNO -->
                    <DataGridTextColumn Header="N° REGISTRO" Binding="{Binding SerieNumero}" Width="120" Foreground="#4B5563"/>

                    <!-- FECHA DE ENVÍO -->
                    <DataGridTextColumn Header="FECHA ENVÍO" Binding="{Binding FechaMovimiento, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>

                    <!-- RUTA: ORIGEN -> DESTINO -->
                    <DataGridTemplateColumn Header="RUTA LOGÍSTICA (ORIGEN ➔ DESTINO)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding AlmacenOrigenNombre}" FontWeight="SemiBold" Foreground="#111827"/>
                                    <TextBlock Text=" ➔ " Foreground="#9CA3AF" FontWeight="Bold" Margin="4,0"/>
                                    <TextBlock Text="{Binding AlmacenDestinoNombre}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TOTALES -->
                    <DataGridTextColumn Header="CANT. CÓDIGOS" Binding="{Binding TotalCodigos}" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ESTADO DEL PAQUETE EN TRÁNSITO -->
                    <DataGridTemplateColumn Header="ESTADO LOGÍSTICO" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsPendiente}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✅ EN ALMACÉN"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsPendiente}" Value="True">
                                                        <Setter Property="Text" Value="⏳ EN TRÁNSITO"/>
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- BOTÓN DINÁMICO DE ACCIÓN (Ver Salida / RECIBIR / Ver Entrada) -->
                    <DataGridTemplateColumn Header="ACCIÓN" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TextoBotonAccion}" 
                                        Background="{Binding ColorBotonAccion}" 
                                        Tag="{Binding}" 
                                        Click="BtnVerDetalle_Click"
                                        Height="28" FontSize="11" FontWeight="Bold" Foreground="White" 
                                        BorderThickness="0" Cursor="Hand" Margin="4">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>