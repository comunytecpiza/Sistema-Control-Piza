<UserControl x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.RegistroComprobantesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9" FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Center">
            <Button Content="📄 Nuevo" Click="BtnNuevo_Click" Width="110" Height="36" Background="#10B981" Style="{StaticResource ModernButton}"/>
            <Button Content="✏️ Modificar" Click="BtnModificar_Click" Width="110" Height="36" Background="#F59E0B" Style="{StaticResource ModernButton}"/>
            <Button Content="🖨️ Imprimir" Click="BtnImprimir_Click" Width="110" Height="36" Background="#3B82F6" Style="{StaticResource ModernButton}"/>
            <Button Content="❌ Anular" Click="BtnAnular_Click" Width="110" Height="36" Background="#EF4444" Style="{StaticResource ModernButton}"/>
        </StackPanel>

        <Grid x:Name="PanelFormulario" Grid.Row="1" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Documento :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,5">
                        <ComboBox x:Name="CmbTipoDocu" Width="150" Margin="0,0,10,0" SelectionChanged="CmbTipoDocu_SelectionChanged">
                            <ComboBoxItem Content="FACTURA" Tag="01" IsSelected="True"/>
                            <ComboBoxItem Content="BOLETA" Tag="02"/>
                            <ComboBoxItem Content="RECIBO" Tag="03"/>
                        </ComboBox>
                        <TextBlock Text="Serie :" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbSerie" Width="80" Margin="0,0,10,0" SelectionChanged="CmbSerie_SelectionChanged"/>
                        <TextBlock Text="Punto Venta :" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtPuntoVenta" Width="200" IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Número :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBox x:Name="TxtNumero" Width="100" IsReadOnly="True" KeyDown="TxtNumero_KeyDown" Background="#F8FAFC" FontWeight="Bold" Margin="0,0,10,0" TextAlignment="Center"/>
                        <Button Content="Saltar N°" Click="BtnSaltarNumero_Click" Width="90" Background="White" BorderBrush="#10B981" BorderThickness="1" Foreground="#10B981" FontWeight="Bold" Cursor="Hand" Margin="0,0,5,0"/>
                        <Button Content="Modificar N°" Click="BtnModificarNumero_Click" Width="108" Background="White" BorderBrush="#10B981" BorderThickness="1" Foreground="#10B981" FontWeight="Bold" Cursor="Hand" Margin="0,0,20,0"/>
                        <TextBlock Text="Fecha :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <DatePicker x:Name="DpFecha" Width="120"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Razón Social :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtRazonSocialBuscador" Grid.Row="2" Grid.Column="1" Margin="0,0,5,5" TextChanged="TxtRazonSocialBuscador_TextChanged" ToolTip="Escriba para buscar al pagador..."/>
                    <TextBox x:Name="TxtRazonSocialId" Grid.Row="2" Grid.Column="2" Margin="0,0,0,5" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="D. Identidad :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,5">
                        <ComboBox x:Name="CmbTipoIdentidad" Width="80" Margin="0,0,10,0">
                            <ComboBoxItem Content="DNI" IsSelected="True"/>
                            <ComboBoxItem Content="RUC"/>
                            <ComboBoxItem Content="CE"/>
                        </ComboBox>
                        <TextBox x:Name="TxtDniRuc" Width="150"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Dir. Pagador :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtDireccionPagador" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Cliente :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtClienteBuscador" Grid.Row="5" Grid.Column="1" Margin="0,0,5,5" TextChanged="TxtClienteBuscador_TextChanged" ToolTip="Escriba para buscar al colegio..."/>
                    <TextBox x:Name="TxtClienteId" Grid.Row="5" Grid.Column="2" Margin="0,0,0,5" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dir. Colegio :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtDireccionColegio" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5" IsReadOnly="True" Background="#F1F5F9"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Localidad / Zona :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtLocalidad" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5" IsReadOnly="True" Background="#F8FAFC"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Observación :" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtObservacion" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,5"/>
                </Grid>
            </Border>

            <Popup x:Name="PopRazonSocial" PlacementTarget="{Binding ElementName=TxtRazonSocialBuscador}" StaysOpen="False" IsOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1">
                    <ListBox x:Name="LstRazonSocial" MaxHeight="150" Width="{Binding ActualWidth, ElementName=TxtRazonSocialBuscador}" SelectionChanged="LstRazonSocial_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RazonSocial}" Padding="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
            <Popup x:Name="PopCliente" PlacementTarget="{Binding ElementName=TxtClienteBuscador}" StaysOpen="False" IsOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1">
                    <ListBox x:Name="LstCliente" MaxHeight="150" Width="{Binding ActualWidth, ElementName=TxtClienteBuscador}" SelectionChanged="LstCliente_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RazonSocial}" Padding="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button x:Name="BtnAgregarItem" Content="➕ Agregar Item" Click="BtnAgregarItem_Click" Width="120" Height="32" Background="White" Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                <Button x:Name="BtnModificarItem" Content="✏️ Modificar Item" Click="BtnModificarItem_Click" Width="130" Height="32" Background="White" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                <Button x:Name="BtnEliminarItem" Content="❌ Eliminar Item" Click="BtnEliminarItem_Click" Width="120" Height="32" Background="White" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                <Button x:Name="BtnLector" Content="🔦 Activar Lector" Click="BtnActivarLector_Click" Width="130" Height="32" Background="White" Foreground="#3B82F6" BorderBrush="#3B82F6" BorderThickness="1" Style="{StaticResource ModernButton}"/>

                <!-- 🌟 NUEVO: este botón nace apagado. Solo se activa cuando, desde el botón
                     "Imprimir" de arriba, se carga un comprobante en modo Vista Previa. -->
                <Button x:Name="BtnImprimirExcel" Content="🖨️ Imprimir Excel" Click="BtnImprimirExcel_Click" Width="140" Height="32" IsEnabled="False" Background="White" Foreground="#8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Style="{StaticResource ModernButton}"/>

                <Border Width="1" Background="#CBD5E0" Margin="10,0"/>

                <Button x:Name="BtnGrabar" Content="💾 Grabar" Click="BtnGrabar_Click" Width="100" Height="32" Background="#10B981" Style="{StaticResource ModernButton}" Cursor=""/>
                <Button Content="↩️ Cancelar" Click="BtnCancelar_Click" Width="100" Height="32" Background="#64748B" Style="{StaticResource ModernButton}"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4" Background="White" ClipToBounds="True">
                <DataGrid x:Name="DgItems" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowHeight="28" HeadersVisibility="Column" SelectionMode="Single" BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionProducto}" Width="3*"/>
                        <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="80"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CanProd}" Width="80"/>
                        <DataGridTextColumn Header="P. Unitario" Binding="{Binding PreUnit}" Width="90"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding ImpTota}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="15" Background="White">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Op. Gravadas :" HorizontalAlignment="Right" Margin="0,0,90,0" Foreground="#64748B"/>
                            <TextBox x:Name="TxtOpGravadas" Text="0.00" Width="80" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Op. Exoneradas :" HorizontalAlignment="Right" Margin="0,0,90,0" Foreground="#64748B"/>
                            <TextBox x:Name="TxtOpExoneradas" Text="0.00" Width="80" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="I.G.V. :" HorizontalAlignment="Right" Margin="0,0,90,0" Foreground="#64748B"/>
                            <TextBox x:Name="TxtIgv" Text="0.00" Width="80" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold"/>
                        </Grid>

                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL VENTA" HorizontalAlignment="Right" Margin="0,0,90,0" FontWeight="Bold" FontSize="14"/>
                                <TextBox x:Name="TxtTotal" Text="0.00" Width="80" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="Bold" FontSize="14" Foreground="#10B981"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
