<Window x:Class="AplicativoDeAlmacen.Views.AgregarRangoModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Rango" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="rbLibroGuia" Content="📘 Libros Guía" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="SemiBold" Cursor="Hand"/>
                <RadioButton x:Name="rbLibroVenta" Content="📗 Libros Venta" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Cantidad :" VerticalAlignment="Center" Margin="0,8" Foreground="#475569" FontWeight="Medium"/>
            <TextBox x:Name="txtSubCantidad" Grid.Column="1" Height="32" Margin="0,8" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="5,0" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Text="Desde :" VerticalAlignment="Center" Margin="0,8" Foreground="#475569" FontWeight="Medium"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1" CornerRadius="4,0,0,4" Padding="8,0" Height="32">
                    <TextBlock x:Name="lblPrefijoDesde" Text="V-" VerticalAlignment="Center" FontWeight="Bold" Foreground="#64748B"/>
                </Border>
                <TextBox x:Name="txtDesde" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="Hasta :" VerticalAlignment="Center" Margin="0,8" Foreground="#475569" FontWeight="Medium"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1" CornerRadius="4,0,0,4" Padding="8,0" Height="32">
                    <TextBlock x:Name="lblPrefijoHasta" Text="V-" VerticalAlignment="Center" FontWeight="Bold" Foreground="#64748B"/>
                </Border>
                <TextBox x:Name="txtHasta" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#F8FAFC"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAceptarRango" Content="💾 Grabar" Grid.Column="0" Height="36" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,5,0" Click="BtnGrabarCodigo_Click" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnCancelarRango" Content="❌ Salir" Grid.Column="1" Height="36" Background="#64748B" Foreground="White" FontWeight="Bold" Margin="5,0,0,0" Click="BtnCancelarRango_Click" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>