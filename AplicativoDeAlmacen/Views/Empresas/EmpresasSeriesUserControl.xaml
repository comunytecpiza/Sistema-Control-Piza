<UserControl x:Class="AplicativoDeAlmacen.Views.Empresas.EmpresasSeriesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO SUPERIOR -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="16,14" BorderBrush="#CBD5E1" BorderThickness="1.2" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Configuración Comercial: Empresas, Series y Monedas" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="Catálogo de empresas emisoras, asignación de series para facturación electrónica y monedas." 
                               FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRefrescarTodo" Content="🔄 Actualizar Catálogos" 
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Height="36" Padding="14,0"
                        BorderBrush="#94A3B8" BorderThickness="1.2" Cursor="Hand" Click="BtnRefrescarTodo_Click"/>
            </Grid>
        </Border>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ======================================================== -->
            <!-- TAB 1: EMPRESAS -->
            <!-- ======================================================== -->
            <TabItem Header="🏢 Empresas Emisoras" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FORMULARIO LATERAL -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="16" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha de Empresa" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                <TextBlock Text="RUC (11 dígitos):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRuc" MaxLength="11" Height="34" Margin="0,0,0,10"/>

                                <TextBlock Text="Razón Social:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRazonSocial" Height="34" Margin="0,0,0,10"/>

                                <TextBlock Text="Nombre Comercial:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtNombreComercial" Height="34" Margin="0,0,0,10"/>

                                <TextBlock Text="Dirección Fiscal:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDireccionFiscal" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                                <CheckBox x:Name="ChkEmpresaActiva" Content="Empresa Activa / Habilitada" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnCancelarEmpresa" Content="Limpiar" Background="#F1F5F9" Foreground="#64748B" 
                                            Height="34" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" Click="BtnCancelarEmpresa_Click"/>
                                    <Button x:Name="BtnGuardarEmpresa" Content="💾 Guardar Empresa" Background="#2563EB" Foreground="#FFFFFF" 
                                            FontWeight="Bold" Height="34" Padding="14,0" Cursor="Hand" Click="BtnGuardarEmpresa_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- GRILLA Y BÚSQUEDA -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtBuscarEmpresa" Height="36" Tag="Buscar empresa por RUC o Razón Social..." TextChanged="TxtBuscarEmpresa_TextChanged"/>

                                <Popup x:Name="PopupSugerenciasEmpresa" PlacementTarget="{Binding ElementName=TxtBuscarEmpresa}" 
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="6" Width="380" MaxHeight="220">
                                        <ListBox x:Name="LstSugerenciasEmpresa" SelectionChanged="LstSugerenciasEmpresa_SelectionChanged" BorderThickness="0" Background="White"/>
                                    </Border>
                                </Popup>

                                <Button Grid.Column="1" x:Name="BtnNuevaEmpresa" Content="➕ Nueva Empresa" Background="#10B981" Foreground="#FFFFFF"
                                        FontWeight="Bold" Height="36" Padding="14,0" Margin="8,0,0,0" Cursor="Hand" Click="BtnNuevaEmpresa_Click"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgEmpresas" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      SelectionChanged="DgEmpresas_SelectionChanged" MouseDoubleClick="DgEmpresas_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="120" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocial}" Width="*"/>
                                    <DataGridTextColumn Header="Nombre Comercial" Binding="{Binding NombreComercial}" Width="160"/>
                                    <DataGridTemplateColumn Header="Estado" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="BrdEstado" CornerRadius="12" Padding="8,2" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="TxtEstado" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                                        <Setter TargetName="BrdEstado" Property="Background" Value="#DCFCE7"/>
                                                        <Setter TargetName="TxtEstado" Property="Text" Value="ACTIVO"/>
                                                        <Setter TargetName="TxtEstado" Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EsActivo}" Value="False">
                                                        <Setter TargetName="BrdEstado" Property="Background" Value="#F1F5F9"/>
                                                        <Setter TargetName="TxtEstado" Property="Text" Value="INACTIVO"/>
                                                        <Setter TargetName="TxtEstado" Property="Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" x:Name="LblTotalEmpresas" Text="Total empresas: 0" FontSize="12" Foreground="#64748B" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 2: SERIES POR EMPRESA -->
            <!-- ======================================================== -->
            <TabItem Header="🧾 Asignación de Series" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Serie Seleccionada:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBlock x:Name="LblSerieSeleccionadaInfo" Text="Seleccione una serie de la tabla para asignarle su empresa" 
                                           FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Empresa Emisora Titular:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboEmpresasParaSerie" Height="34" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="BtnAsignarEmpresaSerie" Content="🔗 Guardar Asignación" 
                                    Background="#0284C7" Foreground="White" FontWeight="Bold" Height="34" Padding="16,0" 
                                    VerticalAlignment="Bottom" Cursor="Hand" Click="BtnAsignarEmpresaSerie_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" x:Name="TxtBuscarSerie" Height="36" Margin="0,0,0,12"
                                     Tag="Filtrar por N° Serie (ej. B001, FA01) o Razón Social..." TextChanged="TxtBuscarSerie_TextChanged"/>

                            <DataGrid Grid.Row="1" x:Name="DgSeriesDocumentos" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      SelectionChanged="DgSeriesDocumentos_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="N° Serie" Binding="{Binding NumeroSerie}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoSerie}" Width="80"/>
                                    <DataGridTextColumn Header="Empresa Asignada" Binding="{Binding Empresa.RazonSocial, TargetNullValue='[ SIN EMPRESA ASIGNADA ]'}" Width="*"/>
                                    <DataGridTextColumn Header="Últ. Boleta" Binding="{Binding CorrelativoBoleta}" Width="100"/>
                                    <DataGridTextColumn Header="Últ. Factura" Binding="{Binding CorrelativoFactura}" Width="100"/>
                                    <DataGridTextColumn Header="Últ. Recibo" Binding="{Binding CorrelativoRecibo}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 3: MONEDAS -->
            <!-- ======================================================== -->
            <TabItem Header="🪙 Monedas" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Ficha de Moneda" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <TextBlock Text="Código SUNAT (ISO):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtCodigoMoneda" MaxLength="5" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Descripción / Nombre:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDescripcionMoneda" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Símbolo:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSimboloMoneda" MaxLength="5" Height="34" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkMonedaActiva" Content="Moneda Habilitada" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnLimpiarMoneda" Content="Limpiar" Background="#F1F5F9" Foreground="#64748B" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnLimpiarMoneda_Click"/>
                                <Button x:Name="BtnGuardarMoneda" Content="💾 Guardar Moneda" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Height="34" Padding="14,0" Click="BtnGuardarMoneda_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1.2" Padding="16">
                        <DataGrid x:Name="DgMonedas" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                  SelectionChanged="DgMonedas_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Código ISO" Binding="{Binding CodigoSunat}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Símbolo" Binding="{Binding Simbolo}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding EsActivo}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>