<UserControl x:Class="AplicativoDeAlmacen.Views.KardexUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Estilo base centrado -->
        <Style x:Key="CenterAlignStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Ingreso Verde Centrado -->
        <Style x:Key="IngresoStyle" TargetType="DataGridCell" BasedOn="{StaticResource CenterAlignStyle}">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Salida Roja Centrada -->
        <Style x:Key="SalidaStyle" TargetType="DataGridCell" BasedOn="{StaticResource CenterAlignStyle}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Saldo Azul Centrado -->
        <Style x:Key="SaldoStyle" TargetType="DataGridCell" BasedOn="{StaticResource CenterAlignStyle}">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📦 Kardex Físico de Productos" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Producto" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboProductos" Width="350" Height="38" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center" TextBoxBase.TextChanged="CboProductos_TextChanged" SelectionChanged="CboProductos_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Desde" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpDesde" 
                            Width="140" 
                            Height="38" 
                            Language="es-ES"
                            SelectedDateFormat="Short"
                            Foreground="#4B5563"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            Padding="4"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Hasta" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpHasta" 
                            Width="140" 
                            Height="38" 
                            Language="es-ES"
                            SelectedDateFormat="Short"
                            Foreground="#4B5563"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            Padding="4"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🚀 Generar Kardex" Width="160" Margin="0,0,10,0" Click="BtnEjecutarKardex_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🖨️ Imprimir" Width="120" Background="#10B981" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand" Click="BtnImprimir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grilla de Detalle -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="1">
            <DataGrid x:Name="KardexDataGrid" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          BorderThickness="0" 
          Background="White" 
          RowHeight="36" 
          HeadersVisibility="Column" 
          GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="#F3F4F6"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          MouseDoubleClick="KardexDataGrid_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#4B5563"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- 1. FECHA MOVIMIENTO -->
                    <DataGridTextColumn Header="FECHA MOV." Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 2. FECHA DE CREACIÓN -->
                    <DataGridTextColumn Header="FECHA CREACIÓN" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 3. USUARIO QUE CREÓ -->
                    <DataGridTextColumn Header="USUARIO CREÓ" Binding="{Binding UsuarioCreador}" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1F2937"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 4. FECHA DE MODIFICACIÓN -->
                    <DataGridTextColumn Header="FECHA MODIF." Binding="{Binding UpdatedAt, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue='-'}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 5. USUARIO QUE MODIFICÓ -->
                    <DataGridTextColumn Header="USUARIO MODIF." Binding="{Binding UsuarioModificador, TargetNullValue='-'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#B45309"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 6. COMPROBANTE -->
                    <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding Registro}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 7. GUÍA -->
                    <DataGridTextColumn Header="GUÍA" Binding="{Binding Guia}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 8. MOTIVO / TIPO -->
                    <DataGridTextColumn Header="MOTIVO / TIPO" Binding="{Binding Tipo}" Width="135">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 9. ENTIDAD / UBICACIÓN / ALMACÉN (Prioridad de espacio) -->
                    <DataGridTextColumn Header="ENTIDAD / UBICACIÓN / ALMACÉN" Binding="{Binding RazonSocialUbicacion}" Width="*" MinWidth="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 10. INGRESO -->
                    <DataGridTextColumn Header="INGRESO" Binding="{Binding Ingreso, StringFormat=N0}" Width="85" CellStyle="{StaticResource IngresoStyle}"/>

                    <!-- 11. SALIDA -->
                    <DataGridTextColumn Header="SALIDA" Binding="{Binding Salida, StringFormat=N0}" Width="85" CellStyle="{StaticResource SalidaStyle}"/>

                    <!-- 12. SALDO ACUMULADO -->
                    <DataGridTextColumn Header="SALDO ACUM." Binding="{Binding SaldoAcumulado, StringFormat=N0}" Width="95" CellStyle="{StaticResource SaldoStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 🌟 LAS 5 TARJETAS SOLICITADAS -->
        <Border Grid.Row="3" Margin="0,15,0,0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
            <UniformGrid Columns="6">
                <!-- 1. Stock Inicial -->
                <Border Background="#F3F4F6" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Stock Inicial" FontSize="11" Foreground="#4B5563" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStockInicial" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- 2. Ingresos Principales (Compras / Transferencias) -->
                <Border Background="#ECFDF5" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="LblTituloIngresos" Text="Ingresos Principales" FontSize="11" Foreground="#065F46" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalIngresos" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <!-- 3. 🌟 NUEVA TARJETA: Devoluciones / Reingresos -->
                <Border Background="#F0F9FF" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Devoluciones / Reingresos" FontSize="11" Foreground="#0369A1" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalDevoluciones" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>

                <!-- 4. Salidas Totales -->
                <Border Background="#FEF2F2" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Salidas Totales" FontSize="11" Foreground="#991B1B" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalSalidas" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- 5. Salidas Fijas (Netas) -->
                <Border Background="#FFF7ED" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Salidas Fijas (Netas)" FontSize="11" Foreground="#9A3412" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSalidasFijas" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#EA580C"/>
                    </StackPanel>
                </Border>

                <!-- 6. Stock Final Almacén -->
                <Border Background="#EFF6FF" CornerRadius="8" Margin="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Stock Final Almacén" FontSize="11" Foreground="#1E3A8A" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStockFinal" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>