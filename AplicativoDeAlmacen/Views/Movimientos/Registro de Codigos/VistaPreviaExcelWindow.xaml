<Window x:Class="AplicativoDeAlmacen.Views.VistaPreviaExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validación de Códigos Excel" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📋 Vista Previa de Códigos" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock x:Name="TxtResumen" Grid.Row="1" Text="Analizando..." Foreground="#6B7280" Margin="0,5,0,15"/>

        <DataGrid x:Name="DgCodigos" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="35">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Incluir, UpdateSourceTrigger=PropertyChanged}" Width="40">
                    <DataGridCheckBoxColumn.Header>
                        <CheckBox x:Name="ChkSeleccionarTodos" IsChecked="True" Click="ChkSeleccionarTodos_Click" ToolTip="Seleccionar Todo"/>
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Código Alfanumérico" Binding="{Binding Codigo}" Width="*" IsReadOnly="True" FontWeight="Bold"/>

                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#10B981"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Estado}" Value="Duplicado">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Background="Transparent" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="Confirmar Selección" Click="BtnConfirmar_Click" Background="#3B82F6" Foreground="White" Padding="15,8" FontWeight="Bold" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>