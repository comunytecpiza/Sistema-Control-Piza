<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.LectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lectura Automática" Height="400" Width="500" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pase los productos por la lectora:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLector" Height="40" FontSize="18" KeyDown="TxtLector_KeyDown" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="LstLog" Grid.Row="1" Margin="0,15,0,15" Background="#1E293B" Foreground="#10B981" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <Button Grid.Row="2" Content="Terminar y Cerrar" Height="40" Click="BtnCerrar_Click" Background="#3182CE" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>