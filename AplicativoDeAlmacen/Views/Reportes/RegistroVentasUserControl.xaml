<UserControl x:Class="AplicativoDeAlmacen.Views.Reportes.RegistroVentasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#0F172A" Direction="270" Opacity="0.04" ShadowDepth="1.5"/>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRA SUPERIOR DE FILTROS -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <!-- Documento -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="150"/>
                    <!-- Serie -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                    <!-- Mes / Año -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Rango Fechas Personalizado -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botones -->
                </Grid.ColumnDefinitions>

                <!-- Documento -->
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="ChkTodosDocumentos" Content="Todos los Documentos" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed"/>
                    <ComboBox x:Name="CmbDocumento" SelectionChanged="CmbDocumento_SelectionChanged" IsEnabled="False">
                        <ComboBoxItem Content="FACTURA" Tag="01"/>
                        <ComboBoxItem Content="BOLETA" Tag="02"/>
                        <ComboBoxItem Content="RECIBO" Tag="03"/>
                    </ComboBox>
                </StackPanel>

                <!-- Serie -->
                <StackPanel Grid.Column="2">
                    <CheckBox x:Name="ChkTodasSeries" Content="Todas las Series" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed"/>
                    <ComboBox x:Name="CmbSerie" IsEnabled="False"/>
                </StackPanel>

                <!-- Mes y Año -->
                <StackPanel Grid.Column="4">
                    <RadioButton x:Name="RbPorMes" Content="Filtrar por Mes" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="RbModoFecha_Checked"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="CmbMes"/>
                        <TextBox Grid.Column="2" x:Name="TxtAno" TextAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Período Libre -->
                <StackPanel Grid.Column="6">
                    <RadioButton x:Name="RbPorRango" Content="Rango Libre" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="RbModoFecha_Checked"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="DpDesde" Width="115" IsEnabled="False"/>
                        <TextBlock Text="al" VerticalAlignment="Center" Foreground="#64748B" Margin="6,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpHasta" Width="115" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botones -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Button Content="⚙️ Ejecutar" Click="BtnEjecutar_Click" Width="105" Height="34" Background="#1E293B" Style="{StaticResource ModernButton}"/>
                    <Button Content="📊 Imprimir" Click="BtnImprimir_Click" Width="105" Height="34" Background="#0F766E" Style="{StaticResource ModernButton}"/>
                    <Button Content="🚪 Salir" Click="BtnSalir_Click" Width="75" Height="34" Background="#64748B" Style="{StaticResource ModernButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. GRILLA REGISTRO DE VENTAS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                    <TextBlock Text="Registro Detallado de Ventas" Foreground="#1E293B" FontWeight="Bold" FontSize="13"/>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DgVentas" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single" Background="Transparent"
                          RowHeight="30" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          ColumnHeaderStyle="{StaticResource ModernGridHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="150" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <DataGridTextColumn Header="Cliente / Razón Social" Binding="{Binding Cliente}" Width="*"/>
                        <DataGridTextColumn Header="Gravado" Binding="{Binding TotalGravado, StringFormat='N2'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Exonerado" Binding="{Binding TotalExonerado, StringFormat='N2'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="IGV" Binding="{Binding TotalIgv, StringFormat='N2'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding ImporteTotal, StringFormat='N2'}" Width="120" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#0F766E"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pie de Sumatorias -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TOTALES GENERALES:" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <TextBox Grid.Column="1" x:Name="TxtTotalGravado" Text="0.00" FontWeight="Bold" FontSize="13" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" x:Name="TxtTotalExonerado" Text="0.00" FontWeight="Bold" FontSize="13" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" x:Name="TxtTotalIgv" Text="0.00" FontWeight="Bold" FontSize="13" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="4" x:Name="TxtTotalImporte" Text="0.00" FontWeight="Bold" FontSize="14.5" Foreground="#0F766E" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl> 