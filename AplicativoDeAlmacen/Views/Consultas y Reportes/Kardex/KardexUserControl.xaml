<UserControl x:Class="AplicativoDeAlmacen.Views.KardexUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="RightAlignStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IngresoStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SalidaStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SaldoStyle" TargetType="DataGridCell" BasedOn="{StaticResource RightAlignStyle}">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📦 Kardex Físico de Productos" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Producto" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboProductos" Width="350" Height="38" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center" TextBoxBase.TextChanged="CboProductos_TextChanged" SelectionChanged="CboProductos_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Desde" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpDesde" Width="140" Height="38"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Hasta" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpHasta" Width="140" Height="38"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="🚀 Generar Kardex" Width="160" Margin="0,0,10,0" Click="BtnEjecutarKardex_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🖨️ Imprimir" Width="120" Background="#10B981" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand" Click="BtnImprimir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grilla de Detalle -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="1">
            <DataGrid x:Name="KardexDataGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White" RowHeight="38" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding Registro}" Width="120"/>
                    <DataGridTextColumn Header="GUÍA" Binding="{Binding Guia}" Width="110"/>
                    <DataGridTextColumn Header="MOTIVO / TIPO" Binding="{Binding Tipo}" Width="160"/>
                    <DataGridTextColumn Header="ENTIDAD / UBICACIÓN / ALMACÉN" Binding="{Binding RazonSocialUbicacion}" Width="*"/>
                    <DataGridTextColumn Header="INGRESO" Binding="{Binding Ingreso, StringFormat=N2}" Width="110" CellStyle="{StaticResource IngresoStyle}"/>
                    <DataGridTextColumn Header="SALIDA" Binding="{Binding Salida, StringFormat=N2}" Width="110" CellStyle="{StaticResource SalidaStyle}"/>
                    <DataGridTextColumn Header="SALDO ACUM." Binding="{Binding SaldoAcumulado, StringFormat=N2}" Width="130" CellStyle="{StaticResource SaldoStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 🌟 LAS 5 TARJETAS SOLICITADAS -->
        <Border Grid.Row="3" Margin="0,15,0,0" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
            <UniformGrid Columns="5">
                <!-- 1. Stock Inicial -->
                <Border Background="#F3F4F6" CornerRadius="8" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Stock Inicial" FontSize="12" Foreground="#4B5563" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStockInicial" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- 2. Ingresos -->
                <Border Background="#ECFDF5" CornerRadius="8" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Ingresos Totales" FontSize="12" Foreground="#065F46" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalIngresos" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <!-- 3. Salidas Brutas -->
                <Border Background="#FEF2F2" CornerRadius="8" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Salidas Totales" FontSize="12" Foreground="#991B1B" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalSalidas" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- 4. Salidas Fijas (Salidas - Devoluciones) -->
                <Border Background="#FFF7ED" CornerRadius="8" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Salidas Fijas (Netas)" FontSize="12" Foreground="#9A3412" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSalidasFijas" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#EA580C"/>
                    </StackPanel>
                </Border>

                <!-- 5. Stock Final -->
                <Border Background="#EFF6FF" CornerRadius="8" Margin="5" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Stock Final Almacén" FontSize="12" Foreground="#1E3A8A" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStockFinal" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>