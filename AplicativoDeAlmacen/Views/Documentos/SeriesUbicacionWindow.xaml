<Window x:Class="AplicativoDeAlmacen.Views.SeriesUbicacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Series Punto de Venta" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTituloSede" Text="Series Punto de Venta : Sede" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Configure las series autorizadas y sus correlativos por tipo de comprobante." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- BOTONERA SUPERIOR -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="✨ Nueva Serie" Click="BtnNuevo_Click" Width="110" Height="35" Margin="0,0,10,0" Background="#10B981" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="✏️ Modificar" Click="BtnModificar_Click" Width="100" Height="35" Margin="0,0,10,0" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="❌ Eliminar" Click="BtnEliminar_Click" Width="90" Height="35" Margin="0,0,10,0" Background="#EF4444" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="🚪 Salir" Click="BtnSalir_Click" Width="80" Height="35" Background="#64748B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- GRILLA DE SERIES -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="2">
                <DataGrid x:Name="DgSeries" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="36" 
                          Background="Transparent" BorderThickness="0" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Serie" Binding="{Binding NumeroSerie}" Width="100" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Cód. Doc" Binding="{Binding TipoSerie}" Width="90"/>
                        <DataGridTextColumn Header="Últ. Factura" Binding="{Binding CorrelativoFactura}" Width="110"/>
                        <DataGridTextColumn Header="Últ. Boleta" Binding="{Binding CorrelativoBoleta}" Width="110"/>
                        <DataGridTextColumn Header="Últ. Recibo / Otros" Binding="{Binding CorrelativoRecibo}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- MODAL FORMULARIO -->
        <Grid x:Name="ModalFormulario" Visibility="Collapsed" Background="#66000000">
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="8" Padding="24" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtTituloModal" Text="Configurar Serie" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>

                    <!-- TIPO DE DOCUMENTO (CATÁLOGO DINÁMICO) -->
                    <TextBlock Text="Tipo de Comprobante:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboDocumentos" Height="34" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo" Margin="0,0,0,12" SelectionChanged="CboDocumentos_SelectionChanged"/>

                    <!-- NÚMERO DE SERIE -->
                    <TextBlock Text="N° de Serie (Ej: F001, B001, T001):" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSerie" Height="34" Padding="8,4" CharacterCasing="Upper" Margin="0,0,0,12"/>

                    <!-- CORRELATIVO -->
                    <TextBlock x:Name="LblCorrelativo" Text="Último Correlativo Emitido:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCorrelativo" Height="34" Padding="8,4" Text="0" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnCerrarModal_Click" Width="90" Height="34" Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="💾 Guardar" Click="BtnGrabarSerie_Click" Width="110" Height="34" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>