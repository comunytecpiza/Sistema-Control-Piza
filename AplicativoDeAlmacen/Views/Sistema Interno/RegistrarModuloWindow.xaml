<Window x:Class="AplicativoDeAlmacen.Views.RegistrarModuloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Módulo" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="🧩 Asignación de Vista" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <TextBlock Text="Vista Técnica Detectada:" Foreground="#64748B" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtVista" IsReadOnly="True" Background="#E2E8F0" Padding="8" Margin="0,5,0,15" Foreground="#475569" FontWeight="Bold"/>

            <CheckBox x:Name="ChkModuloExistente" Content="Vincular a un Módulo que ya existe en la Base de Datos" 
                      Foreground="#3B82F6" FontWeight="Bold" Margin="0,0,0,15" Click="ChkModuloExistente_Click"/>

            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

            <StackPanel x:Name="PanelExistente" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock Text="Seleccione el Módulo Huérfano:" Foreground="#64748B" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboModulosHuerfanos" DisplayMemberPath="NombreModulo" SelectedValuePath="Id" Padding="6" Margin="0,5,0,0" Height="33"/>
                <TextBlock Text="Nota: Solo se muestran módulos sin vista asignada." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel x:Name="PanelNuevo" Visibility="Visible">
                <TextBlock Text="Código Único (Ej: MOD_VENTAS):" Foreground="#64748B" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtCodigo" Padding="8" Margin="0,5,0,15" CharacterCasing="Upper"/>

                <TextBlock Text="Nombre a mostrar en el menú:" Foreground="#64748B" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtNombre" Padding="8" Margin="0,5,0,15"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Categoría:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="Id" Padding="6" Margin="0,5,0,0" Height="33" SelectionChanged="CboCategoria_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Orden:" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtOrden" Text="99" Padding="8" Margin="0,5,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Width="90" Height="35" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontWeight="Bold" Cursor="Hand" Click="BtnCancelar_Click"/>
                <Button Content="💾 Guardar Cambios" Width="150" Height="35" Background="#10B981" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="10,0,0,0" Click="BtnGuardar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>