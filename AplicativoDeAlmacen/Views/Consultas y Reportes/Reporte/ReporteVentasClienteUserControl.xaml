<UserControl x:Class="AplicativoDeAlmacen.Views.Contabilidad.ReporteVentasClienteUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="12.5">

    <UserControl.Resources>
        <!-- Estilo Cabeceras Grilla Rojo/Burdeos como en la captura -->
        <Style x:Key="HeaderPanelTitle" TargetType="Border">
            <Setter Property="Background" Value="#C25353"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
        </Style>

        <Style x:Key="CorporateDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="RightAlignHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CorporateDataGridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CenterAlignHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CorporateDataGridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILTROS SUPERIORES -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Cliente y Localidad -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cliente:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Grid.Row="0" Grid.Column="0" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtClienteBuscador" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,6" TextChanged="TxtClienteBuscador_TextChanged"/>
                    <Button x:Name="BtnLimpiarCliente" Content="Limpiar" Grid.Row="0" Grid.Column="2" Height="28" Click="BtnLimpiarCliente_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,6"/>

                    <!-- Popup sugerencias cliente -->
                    <Popup x:Name="PopCliente" PlacementTarget="{Binding ElementName=TxtClienteBuscador}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="False">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Width="{Binding ActualWidth, ElementName=TxtClienteBuscador}" MaxHeight="180">
                            <ListBox x:Name="LstClientes" SelectionChanged="LstClientes_SelectionChanged" DisplayMemberPath="RazonSocial"/>
                        </Border>
                    </Popup>

                    <TextBlock Text="Localidad / Zona:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="TxtLocalidad" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F8FAFC" Foreground="#64748B"/>
                </Grid>

                <!-- Panel Fechas -->
                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Padding="10,6" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="ChkFiltrarFechas" Content="Filtrar por Fecha" IsChecked="False" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Checked="ChkFiltrarFechas_Changed" Unchecked="ChkFiltrarFechas_Changed"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Desde:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0"/>
                            <DatePicker x:Name="DtpDesde" Width="105" Height="26" IsEnabled="False" Margin="0,0,8,0"/>
                            <TextBlock Text="Hasta:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0"/>
                            <DatePicker x:Name="DtpHasta" Width="105" Height="26" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Botonera Acciones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEjecutar" Click="BtnEjecutar_Click" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0"/>
                            <TextBlock Text="Ejecutar" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnImprimir" Click="BtnImprimir_Click" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,6,0"/>
                            <TextBlock Text="Imprimir" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANELES DE TABLAS (IZQUIERDA: PRODUCTOS, DERECHA: CÓDIGOS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.8*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="5.2*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA IZQUIERDA: PRODUCTOS VENDIDOS -->
            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="White" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource HeaderPanelTitle}">
                        <TextBlock Text="Productos Vendidos" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <DataGrid x:Name="DgProductos" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource CorporateDataGridHeader}" SelectionChanged="DgProductos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoProducto}" Width="80" HeaderStyle="{StaticResource CenterAlignHeader}"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
                            <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="75" HeaderStyle="{StaticResource CenterAlignHeader}"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="75" HeaderStyle="{StaticResource RightAlignHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Importe" Binding="{Binding ImporteTotal, StringFormat=N2}" Width="95" HeaderStyle="{StaticResource RightAlignHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- TABLA DERECHA: DETALLE DE CÓDIGOS -->
            <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="White" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource HeaderPanelTitle}">
                        <TextBlock Text="Detalle de Códigos" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <DataGrid x:Name="DgCodigos" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource CorporateDataGridHeader}" MouseDoubleClick="DgCodigos_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="45" HeaderStyle="{StaticResource CenterAlignHeader}"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="125" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Colección / Tipo" Binding="{Binding ColeccionTipo}" Width="1.2*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="85" HeaderStyle="{StaticResource CenterAlignHeader}"/>
                            <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoFormateado}" Width="110" HeaderStyle="{StaticResource CenterAlignHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=N2}" Width="85" HeaderStyle="{StaticResource RightAlignHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- TOTALES INFERIORES -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Total Ítems:" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalItems" Text="0" Margin="6,0,16,0" FontWeight="Bold" Foreground="#0F172A"/>

                    <TextBlock Text="Total Códigos:" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LblTotalCodigos" Text="0" Margin="6,0,0,0" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL IMPORTE:" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LblTotalImporte" Text="0.00" FontWeight="Bold" FontSize="14" Foreground="#1E40AF"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>