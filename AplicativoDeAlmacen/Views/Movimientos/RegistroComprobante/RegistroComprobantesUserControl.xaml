<UserControl x:Class="AplicativoDeAlmacen.Views.Movimientos.RegistroComprobante.RegistroComprobantesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- Estilo de Etiquetas Espaciosas -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Cajas de Texto Estándar Grandes -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Combos Estándar Grandes -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Botones Modernos -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sombra Suave -->
        <DropShadowEffect BlurRadius="10" Color="#0F172A" Direction="270" Opacity="0.06" ShadowDepth="2" x:Key="CardShadow"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barra superior FIJA -->
            <RowDefinition Height="*"/>
            <!-- ScrollViewer general -->
        </Grid.RowDefinitions>

        <!-- 🌟 BARRA SUPERIOR DE ACCIONES (FIJA ARRIBA) -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📄 Nuevo" Click="BtnNuevo_Click" Width="120" Height="34" Background="#10B981" Style="{StaticResource ModernButton}"/>
                <Button Content="✏️ Modificar" Click="BtnModificar_Click" Width="120" Height="34" Background="#F59E0B" Style="{StaticResource ModernButton}"/>
                <Button Content="🖨️ Imprimir" Click="BtnImprimir_Click" Width="120" Height="34" Background="#3B82F6" Style="{StaticResource ModernButton}"/>
                <Button Content="❌ Anular" Click="BtnAnular_Click" Width="120" Height="34" Background="#EF4444" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Border>

        <!-- 🌟 SCROLLVIEWER GENERAL GRANDE Y CÓMODO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PanelFormulario" IsEnabled="False" Margin="0,0,10,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 1. Cabecera -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. Acciones de ítems -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. Grilla de productos -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4. Multi-Pago amplio y Totales -->
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- 1. CABECERA DIVIDIDA EN 2 COLUMNAS (ESPACIOSA) -->
                <!-- ======================================================== -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA IZQUIERDA -->
                        <StackPanel Grid.Column="0">

                            <!-- Fila 1: Empresa Titular y Moneda -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="🏛️ Empresa Titular Emisora:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtEmpresaTitular" IsReadOnly="True" Background="#F8FAFC" Foreground="#1E3A8A" FontWeight="Bold" Text="[ SELECCIONE SERIE ]"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="🪙 Moneda:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="CmbMoneda" SelectedIndex="0">
                                        <ComboBoxItem Content="SOLES (S/)" Tag="1"/>
                                        <ComboBoxItem Content="DÓLARES ($)" Tag="2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 2: Tipo Doc, Serie y Punto Venta -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Tipo Comprobante:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="CmbTipoDocu" DisplayMemberPath="Descripcion" SelectedValuePath="Codigo" SelectionChanged="CmbTipoDocu_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Serie:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="CmbSerie" SelectionChanged="CmbSerie_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Punto Venta / Sede:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtPuntoVenta" IsReadOnly="True" Background="#F8FAFC" Foreground="#64748B" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 3: Número, Saltos y Fecha -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Número:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtNumero" IsReadOnly="True" KeyDown="TxtNumero_KeyDown" Background="#F8FAFC" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,0">
                                    <Button Content="Saltar N°" Click="BtnSaltarNumero_Click" Width="75" Height="32" Background="White" BorderBrush="#10B981" BorderThickness="1" Foreground="#10B981" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Content="Editar N°" Click="BtnModificarNumero_Click" Width="75" Height="32" Background="White" BorderBrush="#10B981" BorderThickness="1" Foreground="#10B981" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha Emisión:" Style="{StaticResource FormLabelStyle}"/>
                                    <DatePicker x:Name="DpFecha" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 4: Razón Social / Pagador -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Razón Social / Pagador:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtRazonSocialBuscador" TextChanged="TxtRazonSocialBuscador_TextChanged" ToolTip="Escriba para buscar pagador..."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Código:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtRazonSocialId" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 5: Documento Identidad y Dirección -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Doc. Tipo:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="CmbTipoIdentidad">
                                        <ComboBoxItem Content="DNI" IsSelected="True"/>
                                        <ComboBoxItem Content="RUC"/>
                                        <ComboBoxItem Content="CE"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="N° Documento:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtDniRuc"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dirección Fiscal Pagador:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtDireccionPagador"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- COLUMNA DERECHA -->
                        <StackPanel Grid.Column="2">

                            <!-- Fila 1: Delivery Cómodo con Checkbox -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="🛵 Aplica Envío / Delivery:" Style="{StaticResource FormLabelStyle}"/>
                                    <CheckBox x:Name="ChkTieneDelivery" Content="Incluir costo de flete/envío" FontWeight="SemiBold" 
                                              Foreground="#334155" VerticalContentAlignment="Center" Margin="0,6,0,0"
                                              Checked="ChkTieneDelivery_Changed" Unchecked="ChkTieneDelivery_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Monto Delivery (S/):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtMontoDelivery" Text="0.00" TextAlignment="Right" FontWeight="SemiBold" 
                                             IsEnabled="False" Background="#F1F5F9" Foreground="#64748B"
                                             PreviewTextInput="TxtSoloNumerosDecimales_PreviewTextInput"
                                             TextChanged="TxtMontoDelivery_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 2: Cliente / Institución / Colegio -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Cliente / Institución / Colegio:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtClienteBuscador" TextChanged="TxtClienteBuscador_TextChanged" ToolTip="Escriba para buscar colegio..."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Código:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtClienteId" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila 3: Dirección Colegio -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Dirección Colegio:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="TxtDireccionColegio" IsReadOnly="True" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Fila 4: Localidad / Zona -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Localidad / Zona:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="TxtLocalidad" IsReadOnly="True" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Fila 5: Observaciones -->
                            <StackPanel>
                                <TextBlock Text="Observaciones del Comprobante:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="TxtObservacion"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- POPUP AUTOCOMPLETADO PAGADOR -->
                <Popup x:Name="PopRazonSocial" 
       PlacementTarget="{Binding ElementName=TxtRazonSocialBuscador}" 
       Placement="Bottom" 
       StaysOpen="False" 
       IsOpen="False" 
       AllowsTransparency="False"
       PopupAnimation="Fade">
                    <Border Background="White" 
            BorderBrush="#94A3B8" 
            BorderThickness="1.5" 
            CornerRadius="4" 
            MinWidth="380" 
            Width="{Binding ActualWidth, ElementName=TxtRazonSocialBuscador}" 
            Effect="{StaticResource CardShadow}">
                        <ListBox x:Name="LstRazonSocial" 
                 MaxHeight="220" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                 BorderThickness="0"
                 SelectionChanged="LstRazonSocial_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RazonSocial}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Foreground="#64748B" FontSize="11">
                                <Run Text="Doc: "/>
                                <Run Text="{Binding Ruc, TargetNullValue='-'}"/>
                                <Run Text=" | DNI: "/>
                                <Run Text="{Binding Dni, TargetNullValue='-'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- POPUP AUTOCOMPLETADO COLEGIO / INSTITUCIÓN -->
                <Popup x:Name="PopCliente" 
       PlacementTarget="{Binding ElementName=TxtClienteBuscador}" 
       Placement="Bottom" 
       StaysOpen="False" 
       IsOpen="False" 
       AllowsTransparency="False"
       PopupAnimation="Fade">
                    <Border Background="White" 
            BorderBrush="#94A3B8" 
            BorderThickness="1.5" 
            CornerRadius="4" 
            MinWidth="380" 
            Width="{Binding ActualWidth, ElementName=TxtClienteBuscador}" 
            Effect="{StaticResource CardShadow}">
                        <ListBox x:Name="LstCliente" 
                 MaxHeight="220" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                 BorderThickness="0"
                 SelectionChanged="LstCliente_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RazonSocial}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Foreground="#64748B" FontSize="11">
                                <Run Text="Dirección: "/>
                                <Run Text="{Binding Direccion, TargetNullValue='Sin dirección'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                <!-- ======================================================== -->
                <!-- 2. BARRA DE ACCIONES DE PRODUCTOS -->
                <!-- ======================================================== -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnAgregarItem" Content="➕ Agregar Item" Click="BtnAgregarItem_Click" Width="125" Height="32" Background="White" Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                        <Button x:Name="BtnModificarItem" Content="✏️ Modificar Item" Click="BtnModificarItem_Click" Width="130" Height="32" Background="White" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                        <Button x:Name="BtnEliminarItem" Content="❌ Eliminar Item" Click="BtnEliminarItem_Click" Width="120" Height="32" Background="White" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                        <Button x:Name="BtnLector" Content="🔦 Activar Lector" Click="BtnActivarLector_Click" Width="130" Height="32" Background="White" Foreground="#3B82F6" BorderBrush="#3B82F6" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                        <Button x:Name="BtnImprimirExcel" Content="📊 Exportar Excel" Click="BtnImprimirExcel_Click" Width="135" Height="32" IsEnabled="False" Background="White" Foreground="#8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Style="{StaticResource ModernButton}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnGrabar" Content="💾 Guardar Factura" Click="BtnGrabar_Click" Width="140" Height="32" Background="#10B981" Style="{StaticResource ModernButton}"/>
                        <Button Content="↩️ Cancelar" Click="BtnCancelar_Click" Width="95" Height="32" Background="#64748B" Style="{StaticResource ModernButton}"/>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- 3. GRILLA DE ÍTEMS / PRODUCTOS FACTURADOS -->
                <!-- ======================================================== -->
                <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White" ClipToBounds="True" Effect="{StaticResource CardShadow}" MinHeight="180" MaxHeight="300" Margin="0,0,0,14">
                    <DataGrid x:Name="DgItems" 
                              MouseDoubleClick="DgItems_MouseDoubleClick"
                              AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" 
                              RowHeight="30" HeadersVisibility="Column" SelectionMode="Single" BorderThickness="0" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding DescripcionProducto}" Width="*"/>
                            <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="95"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CanProd}" Width="90" FontWeight="Bold"/>
                            <DataGridTextColumn Header="P. Unitario" Binding="{Binding PreUnit, StringFormat='N2'}" Width="110"/>
                            <DataGridTextColumn Header="Importe Total" Binding="{Binding ImpTota, StringFormat='N2'}" Width="120" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ======================================================== -->
                <!-- 4. REGIÓN INFERIOR: MULTI-PAGO Y TOTALES AMPLIADOS -->
                <!-- ======================================================== -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <!-- Desglose de Pagos Amplio -->
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Liquidación Contable -->
                    </Grid.ColumnDefinitions>

                    <!-- 🌟 SUB-MÓDULO: DESGLOSE DE MEDIOS DE PAGO (AMPLIO Y ALTO) -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Título -->
                                <RowDefinition Height="Auto"/>
                                <!-- Fila Añadir Pago -->
                                <RowDefinition Height="Auto"/>
                                <!-- Grilla Alta de Pagos -->
                                <RowDefinition Height="Auto"/>
                                <!-- Barra de Balance y Cuadre -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="💳 Desglose de Medios de Pago / Cobranza (Multi-Pago)" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,12"/>

                            <!-- Formulario para agregar nuevo medio de pago -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Medio / Canal:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox x:Name="CmbMedioPagoManual" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Monto (S/):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtMontoPagoManual" Text="0.00" TextAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="N° Operación / Ref:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox x:Name="TxtOperacionPagoManual" ToolTip="Código de operación bancaria opcional"/>
                                </StackPanel>

                                <Button Grid.Column="3" Content="➕ Añadir" Click="BtnAgregarPago_Click" Height="32" Padding="14,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Style="{StaticResource ModernButton}" VerticalAlignment="Bottom" Margin="0"/>
                            </Grid>

                            <!-- 🌟 Grilla Alta de Pagos Agregados (Sin compresión) -->
                            <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" ClipToBounds="True" MinHeight="160" MaxHeight="220">
                                <DataGrid x:Name="DgPagosManuales" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          RowHeight="30" HeadersVisibility="Column" Background="#F8FAFC"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Canal de Pago" Binding="{Binding MedioPagoNombre}" Width="1.3*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat='S/ {0:N2}'}" Width="105" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="N° Operación / Ref." Binding="{Binding NumeroOperacion}" Width="*"/>
                                        <DataGridTemplateColumn Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️" Click="BtnQuitarPago_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Quitar pago"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Barra de Balance y Cuadre -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total Cobrado: " FontWeight="SemiBold" FontSize="12.5" Foreground="#475569"/>
                                    <TextBlock x:Name="LblTotalCobrado" Text="S/ 0.00" FontWeight="Bold" FontSize="13" Foreground="#2563EB" Margin="0,0,20,0"/>

                                    <TextBlock Text="Diferencia: " FontWeight="SemiBold" FontSize="12.5" Foreground="#475569"/>
                                    <TextBlock x:Name="LblDiferenciaCobro" Text="S/ 0.00" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- LIQUIDACIÓN CONTABLE LATERAL (ESPACIOSA) -->
                    <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18" Background="White" Effect="{StaticResource CardShadow}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Op. Gravadas:" Foreground="#64748B" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBox x:Name="TxtOpGravadas" Text="0.00" Width="95" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold" Background="Transparent"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Op. Exoneradas:" Foreground="#64748B" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBox x:Name="TxtOpExoneradas" Text="0.00" Width="95" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold" Background="Transparent"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="I.G.V. (18%):" Foreground="#64748B" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBox x:Name="TxtIgv" Text="0.00" Width="95" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold" Background="Transparent"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Gasto Delivery:" Foreground="#64748B" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBox x:Name="TxtTotalDelivery" Text="0.00" Width="95" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="SemiBold" Background="Transparent"/>
                            </Grid>

                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="TOTAL VENTA" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTotal" Text="0.00" Width="120" HorizontalAlignment="Right" HorizontalContentAlignment="Right" BorderThickness="0" FontWeight="Bold" FontSize="16" Foreground="#10B981" Background="Transparent"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>