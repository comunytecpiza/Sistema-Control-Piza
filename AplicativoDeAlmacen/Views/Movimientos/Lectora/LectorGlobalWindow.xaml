<Window x:Class="AplicativoDeAlmacen.Views.Movimientos.Lectora.LectorGlobalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Módulo de Captura y Verificación por Pistola"
        Height="620" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="1" Color="#0F172A" Opacity="0.06"/>

        <Style x:Key="CorporateBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO Y TARJETAS -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border BorderBrush="#2563EB" BorderThickness="4,0,0,0" Padding="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Terminal de Lectura y Auditoría" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Captura continua con validación instantánea y clasificación" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Background="White" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricTotal" Text="0" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📙 VENTA" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricVenta" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📘 GUÍA" FontSize="10" FontWeight="Bold" Foreground="#5B21B6" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricGuia" Text="0" FontSize="18" FontWeight="Bold" Foreground="#6D28D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ACEPTADOS" FontSize="10" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricAceptados" Text="0" FontSize="18" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,6" Effect="{StaticResource CardShadow}" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="RECHAZADOS" FontSize="10" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricRechazados" Text="0" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- CAJA DE ENTRADA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10,8" Effect="{StaticResource CardShadow}" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔫" FontSize="20" VerticalAlignment="Center" Margin="6,0,12,0"/>

                <TextBox x:Name="TxtLector" Grid.Column="1" Height="38" FontSize="16" FontWeight="Bold" 
                         Foreground="#1E293B" Background="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="1.5"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,0"
                         KeyDown="TxtLector_KeyDown" GotFocus="TxtLector_GotFocus"/>

                <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="12,0" Margin="10,0,0,0">
                    <TextBlock Text="EN ESPERA DE PISTOLA" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Log y Filtros -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#1E293B" CornerRadius="6,6,0,0" Padding="10,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="📜 Registro en Vivo" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="RbFiltroTodos" Content="Todos" Foreground="White" Margin="0,0,8,0" IsChecked="True" Checked="FiltroLog_Changed"/>
                            <RadioButton x:Name="RbFiltroBuenos" Content="Aceptados" Foreground="#86EFAC" Margin="0,0,8,0" Checked="FiltroLog_Changed"/>
                            <RadioButton x:Name="RbFiltroMalos" Content="Rechazados" Foreground="#FCA5A5" Checked="FiltroLog_Changed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                    <ListBox x:Name="LstLog" Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" Padding="6" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TextoCompleto}" Foreground="{Binding ColorBrush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Panel Derecho: Resumen Consolidado -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#0F766E" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="📦 Resumen por Producto" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="12" Effect="{StaticResource CardShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LblStats" Text="Esperando primeras lecturas..." FontSize="12.5" 
                                   FontFamily="Segoe UI" LineHeight="19" FontWeight="Medium" Foreground="#334155" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- BARRA INFERIOR -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button Content="📊 Exportar Reporte de Sesión" Style="{StaticResource CorporateBtn}" 
                    Background="#10B981" Height="36" Padding="16,0" DockPanel.Dock="Left" Click="BtnExportarModal_Click"/>

            <Button Content="✔ Finalizar e Importar a Grilla" Style="{StaticResource CorporateBtn}" 
                    Background="#2563EB" Height="36" Padding="20,0" DockPanel.Dock="Right" Click="BtnCerrar_Click"/>
        </DockPanel>
    </Grid>
</Window>