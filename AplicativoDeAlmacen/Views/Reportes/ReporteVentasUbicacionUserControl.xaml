<UserControl x:Class="AplicativoDeAlmacen.Views.Reportes.ReporteVentasUbicacionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#0F172A" Direction="270" Opacity="0.04" ShadowDepth="1.5"/>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRA SUPERIOR: UBICACIÓN Y FECHAS -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Columna 1: Ubicación / Código y Localidad -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Ubicación:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtUbicacionBuscador" TextChanged="TxtUbicacionBuscador_TextChanged" ToolTip="Escriba el nombre o código de la ubicación..."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Código:" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtUbicacionCodigo" IsReadOnly="True" Background="#F8FAFC" TextAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Localidad / Zona:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="TxtLocalidadZona" IsReadOnly="True" Background="#F8FAFC" Foreground="#64748B"/>
                    </StackPanel>
                </Grid>

                <!-- Popup Autocompletado de Ubicaciones -->
                <Popup x:Name="PopUbicaciones" PlacementTarget="{Binding ElementName=TxtUbicacionBuscador}" Placement="Bottom" StaysOpen="False" IsOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" MinWidth="420" MaxHeight="220" Effect="{StaticResource CardShadow}">
                        <ListBox x:Name="LstUbicaciones" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" SelectionChanged="LstUbicaciones_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Foreground="#64748B" FontSize="11.5" Margin="0,2,0,0">
                                                <Run Text="Código: "/><Run Text="{Binding Id, StringFormat='D3'}" FontWeight="SemiBold"/>
                                                <Run Text=" | Localidad: "/><Run Text="{Binding Localidad.Nombre}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Columna 2: Sede Fija -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Sede / Almacén:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtSedeActual" IsReadOnly="True" Background="#F8FAFC" Foreground="#1E3A8A" FontWeight="Bold"/>
                </StackPanel>

                <!-- Columna 3: Rango de Fechas -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Rango de Fechas:" Style="{StaticResource FormLabelStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="DpDesde" Width="125" Margin="0,0,8,0"/>
                        <TextBlock Text="al" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpHasta" Width="125"/>
                    </StackPanel>
                </StackPanel>

                <!-- Columna 4: Botones -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Button Content="🔍 Consultar" Click="BtnEjecutar_Click" Width="105" Height="34" Background="#1E293B" Style="{StaticResource ModernButton}"/>
                    <Button Content="📊 Imprimir" Click="BtnImprimir_Click" Width="110" Height="34" Background="#0F766E" Style="{StaticResource ModernButton}"/>
                    <Button Content="↩️ Salir" Click="BtnSalir_Click" Width="75" Height="34" Background="#64748B" Style="{StaticResource ModernButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAESTRO / DETALLE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- PRODUCTOS VENDIDOS EN ESA UBICACIÓN -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Effect="{StaticResource CardShadow}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="Productos Facturados en Ubicación" Foreground="#1E293B" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DgProductos" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" Background="Transparent"
                              RowHeight="30" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}"
                              SelectionChanged="DgProductos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="75" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Descripción del Libro" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="U. Medida" Binding="{Binding UnidadMedida}" Width="85"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='N2'}" Width="85" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='N2'}" Width="100" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock Text="TOTAL GENERAL:" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTotalProductosImporte" Text="S/ 0.00" FontWeight="Bold" FontSize="14.5" Foreground="#0F766E"
                                     BorderThickness="0" Background="Transparent" IsReadOnly="True" 
                                     TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- DETALLE DE CÓDIGOS -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Effect="{StaticResource CardShadow}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="Detalle de Códigos Físicos Vendidos" Foreground="#1E293B" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DgCodigos" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single" Background="Transparent"
                              RowHeight="30" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Código Físico" Binding="{Binding Codigo}" Width="1.2*" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <DataGridTextColumn Header="Colección / Tipo" Binding="{Binding ColeccionTipo}" Width="1.3*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="1.2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='N2'}" Width="90" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Total Códigos: " FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtTotalCodigosCantidad" Text="0" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,16,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Subtotal: " FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBox x:Name="TxtTotalCodigosImporte" Text="S/ 0.00" FontWeight="Bold" FontSize="14.5" Foreground="#0F766E"
                                         BorderThickness="0" Background="Transparent" IsReadOnly="True" 
                                         TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>  