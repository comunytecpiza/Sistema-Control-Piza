<UserControl x:Class="AplicativoDeAlmacen.Views.Contabilidad.ReporteVentasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="CorporateHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="RightAlignHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CorporateHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CenterAlignHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CorporateHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR DE FILTROS Y BOTONES -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtros -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Tipo Documento -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,6" Background="#F8FAFC">
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="chkTodosDocumentos" Content="Todos los Documentos" IsChecked="True" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Doc:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#64748B"/>
                                <ComboBox x:Name="cboTipoDocumento" Width="130" Height="26" IsEnabled="False" SelectionChanged="CboTipoDocumento_SelectionChanged">
                                    <ComboBoxItem Content="01 - FACTURA" Tag="01"/>
                                    <ComboBoxItem Content="02 - BOLETA" Tag="02"/>
                                    <ComboBoxItem Content="03 - RECIBO" Tag="03"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Serie -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,6" Background="#F8FAFC">
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="chkTodasSeries" Content="Todas las Series" IsChecked="True" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Serie:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#64748B"/>
                                <ComboBox x:Name="cboSeries" Width="100" Height="26" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Mes / Año -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,6" Background="#F8FAFC">
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="chkPorMes" Content="Filtro por Mes" IsChecked="True" Checked="ChkModoFecha_Changed" Unchecked="ChkModoFecha_Changed" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="cboMeses" Width="120" Height="26" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtAnio" Width="60" Height="26" Text="2026" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rango Libre -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,6" Background="#F8FAFC">
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="chkPorPeriodo" Content="Rango Específico" IsChecked="False" Checked="ChkModoFecha_Changed" Unchecked="ChkModoFecha_Changed" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Del:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#64748B"/>
                                <DatePicker x:Name="dtpDesde" Width="110" Height="26" Margin="0,0,6,0" IsEnabled="False"/>
                                <TextBlock Text="Al:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#64748B"/>
                                <DatePicker x:Name="dtpHasta" Width="110" Height="26" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnEjecutar" Click="BtnEjecutar_Click" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0"/>
                            <TextBlock Text="Ejecutar" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnImprimirExcel" Click="BtnImprimirExcel_Click" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,6,0"/>
                            <TextBlock Text="Exportar Excel" FontWeight="SemiBold" Foreground="#166534"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSunat" Click="BtnSunat_Click" Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" Margin="0,0,6,0"/>
                            <TextBlock Text="SUNAT" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATA GRID PRINCIPAL -->
        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8,8,0,0" Background="White" ClipToBounds="True">
            <DataGrid x:Name="dgReporteVentas" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False"
              IsReadOnly="True" 
              SelectionMode="Single" 
              SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#F1F5F9" 
              Background="White" 
              BorderThickness="0"
              ColumnHeaderStyle="{StaticResource CorporateHeaderStyle}"
              MouseDoubleClick="DgReporteVentas_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="95" HeaderStyle="{StaticResource CenterAlignHeader}"/>
                    <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoFormateado}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Cliente / Razón Social" Binding="{Binding Cliente}" Width="2*"/>
                    <DataGridTextColumn Header="Gravado" Binding="{Binding Gravado, StringFormat=N2}" Width="100" HeaderStyle="{StaticResource RightAlignHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Exonerado" Binding="{Binding Exonerado, StringFormat=N2}" Width="100" HeaderStyle="{StaticResource RightAlignHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="IGV" Binding="{Binding IGV, StringFormat=N2}" Width="90" HeaderStyle="{StaticResource RightAlignHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110" HeaderStyle="{StaticResource RightAlignHeader}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BARRA INFERIOR DE TOTALES -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Total de Comprobantes:" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblCantidadDocumentos" Text="0" Margin="6,0,0,0" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Gravado:" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblTotalGravado" Text="0.00" FontWeight="Bold" Margin="0,0,16,0"/>

                    <TextBlock Text="Exonerado:" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblTotalExonerado" Text="0.00" FontWeight="Bold" Margin="0,0,16,0"/>

                    <TextBlock Text="IGV:" Foreground="#64748B" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblTotalIgv" Text="0.00" FontWeight="Bold" Margin="0,0,16,0"/>

                    <TextBlock Text="TOTAL:" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblTotalNeto" Text="0.00" FontWeight="Bold" Foreground="#1E40AF" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>