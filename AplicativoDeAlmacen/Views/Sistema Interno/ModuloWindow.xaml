<Window x:Class="AplicativoDeAlmacen.Views.Sistema_Interno.ModuloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Módulo" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI" Loaded="Window_Loaded">

    <StackPanel Margin="25">
        <TextBlock Text="🧩 Edición de Módulo" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <TextBlock Text="Nombre del Módulo:" Foreground="#64748B" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtNombre" Padding="5" Margin="0,5,0,15"/>

        <TextBlock Text="Código (Ej: MOD_VENTAS):" Foreground="#64748B" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtCodigo" Padding="5" Margin="0,5,0,15"/>

        <TextBlock Text="Categoría:" Foreground="#64748B" FontWeight="SemiBold"/>
        <ComboBox x:Name="CboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="Id" Padding="5" Margin="0,5,0,15" Height="30" SelectionChanged="CboCategoria_SelectionChanged"/>

        <TextBlock Text="Orden:" Foreground="#64748B" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtOrden" Padding="5" Margin="0,5,0,20"/>

        <Button Content="💾 Guardar Cambios" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" 
                Cursor="Hand" BorderThickness="0" Click="BtnGuardar_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Window>