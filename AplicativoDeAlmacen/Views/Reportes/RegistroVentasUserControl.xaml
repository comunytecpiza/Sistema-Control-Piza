<UserControl x:Class="AplicativoDeAlmacen.Views.Reportes.RegistroVentasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#0F172A" Direction="270" Opacity="0.04" ShadowDepth="1.5"/>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRA SUPERIOR DE FILTROS -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <!-- Tipo Doc -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                    <!-- Serie -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Modos de Fecha -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botones -->
                </Grid.ColumnDefinitions>

                <!-- Documento -->
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="ChkTodosDocumentos" Content="Todos los Docs" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed"/>
                    <ComboBox x:Name="CmbDocumento" SelectionChanged="CmbDocumento_SelectionChanged" IsEnabled="False">
                        <ComboBoxItem Content="FACTURA" Tag="01"/>
                        <ComboBoxItem Content="BOLETA" Tag="02"/>
                        <ComboBoxItem Content="RECIBO" Tag="03"/>
                    </ComboBox>
                </StackPanel>

                <!-- Serie -->
                <StackPanel Grid.Column="2">
                    <CheckBox x:Name="ChkTodasSeries" Content="Todas las Series" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" Checked="ChkFiltros_Changed" Unchecked="ChkFiltros_Changed"/>
                    <ComboBox x:Name="CmbSerie" IsEnabled="False"/>
                </StackPanel>

                <!-- Modos de Fecha (Groupados sin bloqueos) -->
                <StackPanel Grid.Column="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="RbPorMes" Content="Por Mes" GroupName="FiltroFecha" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,14,0" Checked="RbModoFecha_Changed"/>
                        <RadioButton x:Name="RbPorRango" Content="Rango Libre" GroupName="FiltroFecha" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,14,0" Checked="RbModoFecha_Changed"/>
                        <RadioButton x:Name="RbTodoHistorico" Content="Todo el Histórico" GroupName="FiltroFecha" FontWeight="SemiBold" Foreground="#0F766E" Checked="RbModoFecha_Changed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbMes" Width="125" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtAno" Width="65" TextAlignment="Center" Margin="0,0,14,0"/>

                        <DatePicker x:Name="DpDesde" Width="110" IsEnabled="False"/>
                        <TextBlock Text="al" VerticalAlignment="Center" Foreground="#64748B" Margin="6,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpHasta" Width="110" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botones -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Button Content="⚙️ Ejecutar" Click="BtnEjecutar_Click" Width="100" Height="32" Background="#1E293B" Style="{StaticResource ModernButton}"/>
                    <Button Content="📊 Imprimir" Click="BtnImprimir_Click" Width="100" Height="32" Background="#0F766E" Style="{StaticResource ModernButton}"/>
                    <Button Content="🚪 Salir" Click="BtnSalir_Click" Width="70" Height="32" Background="#64748B" Style="{StaticResource ModernButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. GRILLA REGISTRO DE VENTAS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <TextBlock Text="Registro de Ventas e Ingresos" Foreground="#1E293B" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalRegistros" Text="0 comprobantes encontrados" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" x:Name="DgVentas" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single" Background="Transparent"
                          RowHeight="28" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          ColumnHeaderStyle="{StaticResource ModernGridHeader}">
                    <DataGrid.Columns>
                        <!-- 📅 Fecha legal de emisión primero -->
                        <DataGridTextColumn Header="F. Emisión" Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Comprobante" Binding="{Binding Documento}" Width="135" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <DataGridTextColumn Header="Cliente / Razón Social" Binding="{Binding Cliente}" Width="*"/>

                        <!-- Importes -->
                        <DataGridTextColumn Header="Gravado" Binding="{Binding TotalGravado, StringFormat='N2'}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Exonerado" Binding="{Binding TotalExonerado, StringFormat='N2'}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="IGV" Binding="{Binding TotalIgv, StringFormat='N2'}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Delivery / Flete -->
                        <DataGridTextColumn Header="Delivery" Binding="{Binding MontoDelivery, StringFormat='N2'}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#0284C7"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total Final -->
                        <DataGridTextColumn Header="Total Venta" Binding="{Binding ImporteTotal, StringFormat='N2'}" Width="105" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#0F766E"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 👤 Auditoría de Creación -->
                        <DataGridTextColumn Header="Registrado Por" Binding="{Binding UsuarioCreador}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ✏️ Auditoría de Modificación junto a su fecha -->
                        <DataGridTextColumn Header="Modificado Por" Binding="{Binding UsuarioEditor}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="F. Edición" Binding="{Binding FechaModificacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pie de Sumatorias -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                            <!-- Gravado -->
                            <ColumnDefinition Width="90"/>
                            <!-- Exonerado -->
                            <ColumnDefinition Width="75"/>
                            <!-- IGV -->
                            <ColumnDefinition Width="80"/>
                            <!-- Delivery -->
                            <ColumnDefinition Width="105"/>
                            <!-- Total -->
                            <ColumnDefinition Width="335"/>
                            <!-- Espacio Auditoría -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TOTALES GENERALES:" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <TextBox Grid.Column="1" x:Name="TxtTotalGravado" Text="0.00" FontWeight="Bold" FontSize="12" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="2" x:Name="TxtTotalExonerado" Text="0.00" FontWeight="Bold" FontSize="12" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" x:Name="TxtTotalIgv" Text="0.00" FontWeight="Bold" FontSize="12" Foreground="#1E293B" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="4" x:Name="TxtTotalDelivery" Text="0.00" FontWeight="Bold" FontSize="12" Foreground="#0284C7" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="5" x:Name="TxtTotalImporte" Text="0.00" FontWeight="Bold" FontSize="13.5" Foreground="#0F766E" BorderThickness="0" Background="Transparent" IsReadOnly="True" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>