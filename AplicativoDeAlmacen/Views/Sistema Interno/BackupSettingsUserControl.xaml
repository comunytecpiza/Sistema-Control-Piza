<UserControl x:Class="AplicativoDeAlmacen.Views.SistemaInterno.BackupSettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="#F8FAFC" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Sombras limpias para modo blanco -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Color="#0F172A" Opacity="0.06"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="8" ShadowDepth="1" Color="#0F172A" Opacity="0.04"/>

        <!-- Inputs en Fondo Blanco -->
        <Style x:Key="WhiteTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones Modernos -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#059669"/>
        </Style>

        <Style x:Key="BtnDark" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#0F172A"/>
        </Style>

        <Style x:Key="BtnLight" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20" Effect="{StaticResource HeaderShadow}">
                <DockPanel LastChildFill="True">
                    <Border Width="4" Height="40" Background="#2563EB" CornerRadius="2" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Copias de Seguridad (Hosting &amp; Local)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0.10" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Generación en servidor privado, réplicas locales y notificaciones push inmediatas a iOS" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="14" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="SERVIDOR ACTIVO" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- PANEL DE CONFIGURACIÓN -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: RUTAS Y HORARIOS -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="⚙️ Programación y Almacenamiento" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="SERVIDOR / LOCAL" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>

                        <!-- Carpeta Destino en PC -->
                        <TextBlock Text="Carpeta de Descargas en esta PC Local:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRutaDestino" Style="{StaticResource WhiteTextBox}" IsReadOnly="True" Height="36"/>
                            <Button x:Name="btnSeleccionarCarpeta" Grid.Column="2" Content="📁 Examinar" Click="BtnSeleccionarCarpeta_Click" Style="{StaticResource BtnLight}" Height="36"/>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- Esquema Automatización -->
                        <TextBlock Text="Esquema de Automatización en el Servidor:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="rbModoDiario" Content="Respaldo Diario General" IsChecked="True" Checked="ModoHorario_Changed" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,20,0"/>
                            <RadioButton x:Name="rbModoIntervalo" Content="Respaldo por Intervalos de Horas" Checked="ModoHorario_Changed" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>

                        <!-- Panel Diario General -->
                        <Border x:Name="pnlDiarioGeneral" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <TextBlock Text="Hora de ejecución diaria (Formato 24h):" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold"/>
                                    <TextBlock Text="Se generará en backup_control del hosting y enviará alerta al móvil." FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <TextBox x:Name="txtHoraDiaria" DockPanel.Dock="Right" Text="02:00" Width="80" Height="32" Style="{StaticResource WhiteTextBox}" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                            </DockPanel>
                        </Border>

                        <!-- Panel Rango Operativo (Con selector de Horas Clara y Visible) -->
                        <Border x:Name="pnlRangoOperativo" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Desde:" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtHoraDesde" Grid.Row="2" Grid.Column="0" Text="08:00" Style="{StaticResource WhiteTextBox}" Height="34" HorizontalContentAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Hasta:" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                <TextBox x:Name="txtHoraHasta" Grid.Row="2" Grid.Column="2" Text="19:00" Style="{StaticResource WhiteTextBox}" Height="34" HorizontalContentAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Frecuencia:" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>

                                <!-- ComboBox con alto contraste y opciones legibles -->
                                <ComboBox x:Name="cboFrecuenciaHoras" Grid.Row="2" Grid.Column="4" Height="34" 
                                          Background="#FFFFFF" Foreground="#0F172A" FontSize="12" 
                                          VerticalContentAlignment="Center" BorderBrush="#CBD5E1">
                                    <ComboBoxItem Content="Cada 1 Hora" Foreground="#0F172A" Padding="6,4"/>
                                    <ComboBoxItem Content="Cada 2 Horas" Foreground="#0F172A" Padding="6,4" IsSelected="True"/>
                                    <ComboBoxItem Content="Cada 3 Horas" Foreground="#0F172A" Padding="6,4"/>
                                    <ComboBoxItem Content="Cada 4 Horas" Foreground="#0F172A" Padding="6,4"/>
                                    <ComboBoxItem Content="Cada 5 Horas" Foreground="#0F172A" Padding="6,4"/>
                                    <ComboBoxItem Content="Cada 6 Horas" Foreground="#0F172A" Padding="6,4"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Retención -->
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="Retención local en disco (Días):" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold"/>
                                <TextBlock Text="Días a conservar las réplicas antes de purgar archivos antiguos." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <TextBox x:Name="txtDiasRetencion" DockPanel.Dock="Right" Text="15" Width="60" Height="32" Style="{StaticResource WhiteTextBox}" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: TELEMETRÍA NTFY & ACCIONES -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="📲 Alertas Push Móvil (iPhone)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="NTFY.SH" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>

                        <TextBlock Text="Canal / Tópico suscrito en la App ntfy:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtCanalNtfy" Text="Sistemas_pizza" Style="{StaticResource WhiteTextBox}" Height="36" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Recibirás alerta sonora de éxito o fallo ante caídas de MySQL." FontSize="11" Foreground="#64748B" Margin="0,0,0,14"/>

                        <Button x:Name="btnProbarNotificacion" Content="🔊 Probar Notificación en iPhone" Click="BtnProbarNotificacion_Click" Style="{StaticResource BtnLight}" Height="36" Margin="0,0,0,16"/>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <Button x:Name="btnGuardarConfiguracion" Content="💾 Guardar Programación" Click="BtnGuardarConfiguracion_Click" Style="{StaticResource BtnSuccess}" Height="38" Margin="0,0,0,10"/>
                        <Button x:Name="btnEjecutarManual" Content="⚡ Generar Respaldo en Servidor Ahora" Click="BtnEjecutarManual_Click" Style="{StaticResource BtnDark}" Height="40"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CARD 3: TABLA DE RESPALDOS -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="📋 Respaldos Resguardados en Servidor (backup_control)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Content="🔄 Actualizar Servidor" Click="BtnRefrescarHistorial_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" Cursor="Hand" FontSize="12"/>
                    </DockPanel>

                    <!-- DataGrid en Fondo Blanco con Texto Negro Nítido -->
                    <DataGrid x:Name="dgHistorialBackups" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="230"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#E2E8F0" HorizontalGridLinesBrush="#E2E8F0" Foreground="#0F172A"
                              FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ARCHIVO MYSQL" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="FECHA GENERACIÓN" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="170"/>
                            <DataGridTextColumn Header="TAMAÑO" Binding="{Binding TamanoFormateado}" Width="120"/>
                            <DataGridTextColumn Header="ESTADO SERVIDOR" Binding="{Binding Estado}" Width="130"/>
                            <DataGridTemplateColumn Header="ADMIN TI" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⬇️ Descargar a PC" Click="BtnAbrirUbicacionArchivo_Click" 
                                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" 
                                                BorderThickness="0" Padding="8,4" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>